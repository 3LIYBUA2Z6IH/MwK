    if KeybindListWindow.Gui then KeybindListWindow.Gui:Destroy() end

    KeybindListWindow.Gui = New("ScreenGui", {
        Name = "NovaUIKeybindList",
        Parent = GetSafeParent(),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        ResetOnSpawn = false
    })

    -- AnchorPoint kanan-atas + posisi scale -> aman untuk semua resolusi
    KeybindListWindow.Frame = New("Frame", {
        Parent = KeybindListWindow.Gui,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.new(0, 160, 0, 34),
