-- // NovaUI Compact
-- // Roblox UI Library
local NovaUI = {}
NovaUI.__index = NovaUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- // Keep NovaUI alive after death/respawn
local function protectGui(gui)
    if not gui then return end

    gui.ResetOnSpawn = false
    gui.Archivable = true

    if gui.Parent ~= PlayerGui then gui.Parent = PlayerGui end
end

for _, gui in ipairs(PlayerGui:GetChildren()) do
    if gui:IsA("ScreenGui") and gui.Name:sub(1, 6) == "NovaUI" then
        gui:Destroy()
    end
end

local C = {
    Background = Color3.fromRGB(14, 13, 15),
    Sidebar = Color3.fromRGB(23, 20, 23),
    Top = Color3.fromRGB(23, 20, 23),
    Element = Color3.fromRGB(23, 20, 23),
    ElementHover = Color3.fromRGB(32, 28, 32),
    Border = Color3.fromRGB(40, 36, 40),
    Text = Color3.fromRGB(240, 235, 238),
    SubText = Color3.fromRGB(140, 132, 140),
    Accent = Color3.fromRGB(230, 65, 85),
    Accent2 = Color3.fromRGB(170, 48, 62)
}

local function New(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    return obj
end

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function Stroke(obj)
    local s = Instance.new("UIStroke")
    s.Color = C.Border
    s.Thickness = 1
    s.Parent = obj
end

local function Clamp01(v) return math.clamp(v, 0, 1) end

-- estimasi lebar teks (px) untuk anti-tabrakan: ~px per karakter Gotham
local function EstTextWidth(text, perChar)
    return math.ceil(#tostring(text) * (perChar or 6))
end

local function ClosePicker(self)
    if self.ActiveColorPicker then self.ActiveColorPicker.Visible = false end
    self.ActiveColorPicker = nil
    self.ActiveColorButton = nil
end

function NovaUI.new(title)
    local self = setmetatable({}, NovaUI)
    self.Pages = {}
    self.ConfigItems = {} -- registry komponen untuk Save/Load Configuration
    self.CurrentPage = nil
    self.ActiveColorPicker = nil
    self.ActiveColorButton = nil

    self.Gui = New("ScreenGui", {
        Name = "NovaUI_Main",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100000,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        Parent = PlayerGui
    })

    self.ColorGui = New("ScreenGui", {
        Name = "NovaUI_ColorPicker",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 2147483646,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        Enabled = true,
        Parent = PlayerGui
    })

    protectGui(self.Gui)
    protectGui(self.ColorGui)

    self.Main = New("Frame", {
        Parent = self.Gui,
        Size = UDim2.fromOffset(220, 300),
        Position = UDim2.new(0.5, -110, 0.5, -150),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        ZIndex = 10
    })
    Corner(self.Main, 5)
    Stroke(self.Main)

    -- ================================================================
    -- ANTI-TABRAKAN: lebar window bertambah otomatis kalau ada teks
    -- yang panjang (toggle/slider/sheet/dll), tetap di tengah layar
    -- ================================================================
    self.MinWidth = 220
    function self:EnsureWidth(w)
        w = math.max(self.MinWidth, math.floor(w))
        local cur = self.Main.Size.X.Offset
        if w > cur then
            local h = self.Main.Size.Y.Offset
            self.Main.Size = UDim2.fromOffset(w, h)
            self.Main.Position = UDim2.new(0.5, -math.floor(w / 2), 0.5,
                                           -math.floor(h / 2))
        end
    end

    self.Top = New("Frame", {
        Parent = self.Main,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = C.Top,
        BorderSizePixel = 0,
        ZIndex = 11
    })

    New("TextLabel", {
        Parent = self.Top,
        Size = UDim2.new(1, -45, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = title or "Nova",
        TextColor3 = C.Text,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12
    })

    local close = New("TextButton", {
        Parent = self.Top,
        Size = UDim2.fromOffset(25, 24),
        Position = UDim2.new(1, -29, 0, 3),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = C.SubText,
        TextSize = 16,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        ZIndex = 12
    })

    close.MouseButton1Click:Connect(function()
        self.Gui.Enabled = false
        ClosePicker(self)
    end)

    self.Sidebar = New("Frame", {
        Parent = self.Main,
        Size = UDim2.new(0, 35, 1, -30),
        Position = UDim2.fromOffset(0, 30),
        BackgroundColor3 = C.Sidebar,
        BorderSizePixel = 0,
        ZIndex = 11
    })

    New("UIListLayout", {
        Parent = self.Sidebar,
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Padding = UDim.new(0, 4)
    })

    local sidePadding = Instance.new("UIPadding")
    sidePadding.PaddingTop = UDim.new(0, 7)
    sidePadding.Parent = self.Sidebar

    self.Content = New("Frame", {
        Parent = self.Main,
        Size = UDim2.new(1, -35, 1, -30),
        Position = UDim2.fromOffset(35, 30),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        ZIndex = 11
    })

    -- ================================================================
    -- SETTING PAGE (FIX: selalu berada paling bawah di sidebar)
    -- ================================================================
    self.SettingPage = self:AddPage("Setting", "⚙")
    -- LayoutOrder terbesar → tombol Setting selalu di paling bawah,
    -- berapapun jumlah page yang ditambahkan user
    self.SettingPage.Button.LayoutOrder = 999999999
    self.SettingPage.Frame.Visible = false
    self.CurrentPage = nil

    self.SettingPage:AddTitle("Setting")

    -- ================================================================
    -- SAVE/LOAD CONFIGURATION (baris paling atas page Setting)
    -- Filesystem dicek dulu; jika tidak tersedia, tampilkan status
    -- "Filesystem unavailable" tanpa crash.
    -- ================================================================
    local CONFIG_FOLDER = "NovaUI_Configs"
    local FS_OK = (typeof(readfile) == "function" and typeof(writefile) ==
                      "function" and typeof(listfiles) == "function")

    local cfgSelected = nil -- nama file yang dipilih di list
    local cfgStatusLbl = nil
    local cfgNameBox = nil

    local function cfgFileName(raw)
        raw = tostring(raw):gsub("%.json%s*$", "")
        raw = raw:gsub("[^%w%-_ ]", "")
        if raw == "" then raw = "config" end
        return raw .. ".json"
    end

    local function cfgSetStatus(msg, isError)
        if cfgStatusLbl then
            cfgStatusLbl.Text = msg
            cfgStatusLbl.TextColor3 = isError and Color3.fromRGB(230, 65, 85) or
                                          C.Text
        end
    end

    -- ---- file list panel ----
    local fileList = New("ScrollingFrame", {
        Parent = self.SettingPage.Frame,
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = C.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ClipsDescendants = true,
        ZIndex = 13
    })
    Corner(fileList, 4)
    Stroke(fileList)

    -- ---- file name textbox ----
    cfgNameBox = New("TextBox", {
        Parent = self.SettingPage.Frame,
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "File name...",
        PlaceholderColor3 = C.SubText,
        TextColor3 = C.Text,
        TextSize = 9,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = 13
    })
    local np = Instance.new("UIPadding")
    np.PaddingLeft = UDim.new(0, 6)
    np.Parent = cfgNameBox
    Corner(cfgNameBox, 4)
    Stroke(cfgNameBox)

    -- ---- helper: baris 2 tombol ----
    local function cfgButtonRow(text1, text2)
        local row = New("Frame", {
            Parent = self.SettingPage.Frame,
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 13
        })
        local b1 = New("TextButton", {
            Parent = row,
            Size = UDim2.new(0.5, -3, 1, 0),
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = text1,
            TextColor3 = C.Text,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            ZIndex = 14
        })
        local b2 = New("TextButton", {
            Parent = row,
            Position = UDim2.new(0.5, 3, 0, 0),
            Size = UDim2.new(0.5, -3, 1, 0),
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = text2,
            TextColor3 = C.Text,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            ZIndex = 14
        })
        for _, b in ipairs({b1, b2}) do
            Corner(b, 4)
            Stroke(b)
            b.MouseEnter:Connect(function()
                b.BackgroundColor3 = C.ElementHover
            end)
            b.MouseLeave:Connect(function()
                b.BackgroundColor3 = C.Element
            end)
        end
        return b1, b2
    end

    local saveBtn, createBtn = cfgButtonRow("Save", "Create")
    local loadBtn, refreshBtn = cfgButtonRow("Load", "Refresh")

    -- ---- status feedback ----
    cfgStatusLbl = New("TextLabel", {
        Parent = self.SettingPage.Frame,
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundTransparency = 1,
        Text = FS_OK and "" or "Filesystem unavailable",
        TextColor3 = FS_OK and C.SubText or Color3.fromRGB(230, 65, 85),
        TextSize = 8,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 13
    })

    local function refreshFiles()
        for _, c in pairs(fileList:GetChildren()) do
            if c:IsA("TextButton") or c:IsA("TextLabel") then
                c:Destroy()
            end
        end

        if not FS_OK then
            New("TextLabel", {
                Parent = fileList,
                Size = UDim2.new(1, -8, 0, 14),
                Position = UDim2.fromOffset(4, 3),
                BackgroundTransparency = 1,
                Text = "Filesystem unavailable",
                TextColor3 = Color3.fromRGB(230, 65, 85),
                TextSize = 8,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 14
            })
            return
        end

        local files = {}
        local ok, listed = pcall(listfiles, CONFIG_FOLDER)
        if ok and typeof(listed) == "table" then
            for _, path in ipairs(listed) do
                local nm = path:match("[/\\]([^/\\]+)$") or path
                if nm:match("%.json$") then
                    table.insert(files, nm)
                end
            end
        end

        if #files == 0 then
            New("TextLabel", {
                Parent = fileList,
                Size = UDim2.new(1, -8, 0, 14),
                Position = UDim2.fromOffset(4, 3),
                BackgroundTransparency = 1,
                Text = "No configuration files",
                TextColor3 = C.SubText,
                TextSize = 8,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 14
            })
            return
        end

        for i, nm in ipairs(files) do
            local fb = New("TextButton", {
                Parent = fileList,
                Position = UDim2.new(0, 4, 0, (i - 1) * 16 + 2),
                Size = UDim2.new(1, -8, 0, 14),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Text = nm,
                TextColor3 = (nm == cfgSelected) and C.Accent or C.Text,
                TextSize = 8,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                ZIndex = 14
            })
            fb.MouseButton1Click:Connect(function()
                cfgSelected = nm
                cfgNameBox.Text = nm
                refreshFiles()
            end)
        end
    end

    local function collectConfig()
        local data = {}
        for _, item in ipairs(self.ConfigItems) do
            local ok, val = pcall(item.Get)
            if ok and val ~= nil then
                data[item.Name] = {type = item.Type, value = val}
            end
        end
        return {values = data}
    end

    local function doSave()
        if not FS_OK then
            cfgSetStatus("Filesystem unavailable", true)
            return
        end
        local raw = cfgNameBox.Text
        if raw == "" then
            cfgSetStatus("No file name", true)
            return
        end

        local name = cfgFileName(raw)
        local okEnc, encoded = pcall(function()
            return HttpService:JSONEncode(collectConfig())
        end)
        if not okEnc then
            cfgSetStatus("Encode error", true)
            return
        end

        local okWrite = pcall(function()
            if typeof(isfolder) == "function" and not isfolder(CONFIG_FOLDER) and
                typeof(makefolder) == "function" then
                makefolder(CONFIG_FOLDER)
            end
            writefile(CONFIG_FOLDER .. "/" .. name, encoded)
        end)
        if not okWrite then
            cfgSetStatus("Save failed", true)
            return
        end

        cfgSelected = name
        cfgSetStatus("Saved: " .. name)
        refreshFiles()
    end

    local function doCreate()
        if not FS_OK then
            cfgSetStatus("Filesystem unavailable", true)
            return
        end
        local raw = cfgNameBox.Text
        if raw == "" then
            cfgSetStatus("No file name", true)
            return
        end

        local name = cfgFileName(raw)
        if typeof(isfile) == "function" and isfile(CONFIG_FOLDER .. "/" .. name) then
            cfgSetStatus("Already exists: " .. name, true)
            return
        end

        local okEnc, encoded = pcall(function()
            return HttpService:JSONEncode(collectConfig())
        end)
        if not okEnc then
            cfgSetStatus("Encode error", true)
            return
        end

        local okWrite = pcall(function()
            if typeof(isfolder) == "function" and not isfolder(CONFIG_FOLDER) and
                typeof(makefolder) == "function" then
                makefolder(CONFIG_FOLDER)
            end
            writefile(CONFIG_FOLDER .. "/" .. name, encoded)
        end)
        if not okWrite then
            cfgSetStatus("Create failed", true)
            return
        end

        cfgSelected = name
        cfgSetStatus("Created: " .. name)
        refreshFiles()
    end

    local function doLoad()
        if not FS_OK then
            cfgSetStatus("Filesystem unavailable", true)
            return
        end
        if not cfgSelected then
            cfgSetStatus("No file selected", true)
            return
        end

        local path = CONFIG_FOLDER .. "/" .. cfgSelected
        if typeof(isfile) == "function" and not isfile(path) then
            cfgSetStatus("File not found: " .. cfgSelected, true)
            return
        end

        local okRead, content = pcall(readfile, path)
        if not okRead then
            cfgSetStatus("Read failed", true)
            return
        end

        local okDec, decoded = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if not okDec or typeof(decoded) ~= "table" then
            cfgSetStatus("Invalid config", true)
            return
        end

        local data = decoded.values or decoded
        local applied = 0
        for _, item in ipairs(self.ConfigItems) do
            local entry = data[item.Name]
            if typeof(entry) == "table" and entry.value ~= nil and entry.type ==
                item.Type then
                local okSet = pcall(item.Set, entry.value)
                if okSet then applied = applied + 1 end
            end
        end
        cfgSetStatus("Loaded: " .. cfgSelected .. " (" .. applied .. ")")
    end

    saveBtn.MouseButton1Click:Connect(doSave)
    createBtn.MouseButton1Click:Connect(doCreate)
    loadBtn.MouseButton1Click:Connect(doLoad)
    refreshBtn.MouseButton1Click:Connect(function()
        if not FS_OK then
            cfgSetStatus("Filesystem unavailable", true)
            return
        end
        refreshFiles()
        cfgSetStatus("Refreshed")
    end)

    refreshFiles()
    self.SettingPage:AddButton("Destroy UI", function()
        self.ActiveColorPicker = nil
        self.ActiveColorButton = nil
        KeybindListWindow.Destroy()
        self.Gui:Destroy()
        self.ColorGui:Destroy()
    end)

    -- Toggle Keybind List (satu-satunya toggle di page Setting, tanpa keybind)
    self.SettingPage:AddToggle("Keybind List", false, function(state)
        if state then
            KeybindListWindow.Show()
        else
            KeybindListWindow.Hide()
        end
    end, {keybind = false})

    -- ================================================================
    -- KEYBIND UI (Setting): hide/show MENU UI saja
    -- Tidak masuk Keybind List, hanya untuk sembunyi/tampil menu
    -- ================================================================
    local kbHolder = New("Frame", {
        Parent = self.SettingPage.Frame,
        Size = UDim2.new(1, 0, 0, 25),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 13
    })

    New("TextLabel", {
        Parent = kbHolder,
        Size = UDim2.new(1, -110, 1, 0),
        BackgroundTransparency = 1,
        Text = "Hide UI",
        TextColor3 = C.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 14
    })

    local uiKeyBtn = New("TextButton", {
        Parent = kbHolder,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0),
        Size = UDim2.fromOffset(96, 22),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
        Text = "None",
        TextColor3 = C.SubText,
        TextSize = 9,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        ZIndex = 14
    })
    Corner(uiKeyBtn, 4)
    Stroke(uiKeyBtn)

    local uiKey = nil
    local uiRecording = false

    uiKeyBtn.MouseButton1Click:Connect(function()
        if uiRecording then return end
        uiRecording = true
        KeybindList.StartRecording()
        uiKeyBtn.Text = "Press key..."
        uiKeyBtn.TextSize = 8
        uiKeyBtn.TextColor3 = C.Text
    end)

    UIS.InputBegan:Connect(function(input, gameProcessed)
        if uiRecording then
            if input.KeyCode == Enum.KeyCode.Backspace then
                uiKey = nil
                uiKeyBtn.Text = "None"
                uiKeyBtn.TextSize = 9
                uiKeyBtn.TextColor3 = C.SubText
                uiRecording = false
                KeybindList.StopRecording()
                return
            end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                uiKey = input.KeyCode
                uiKeyBtn.Text = uiKey.Name
                uiKeyBtn.TextSize = 9
                uiKeyBtn.TextColor3 = C.Text
                uiRecording = false
                KeybindList.StopRecording()
            end
            return
        end
        -- hotkey: hide/show MENU UI saja (Keybind List tidak ikut)
        if not gameProcessed and uiKey and input.KeyCode == uiKey then
            self.Gui.Enabled = not self.Gui.Enabled
        end
    end)

    -- // Re-parent UI if Roblox removes/reparents it during respawn
    Player.CharacterAdded:Connect(function()
        task.defer(function()
            task.wait(0.1)

            if self.Gui and self.Gui.Parent ~= PlayerGui then
                self.Gui.Parent = PlayerGui
            end

            if self.ColorGui and self.ColorGui.Parent ~= PlayerGui then
                self.ColorGui.Parent = PlayerGui
            end

            if self.Gui then self.Gui.ResetOnSpawn = false end

            if self.ColorGui then self.ColorGui.ResetOnSpawn = false end
        end)
    end)

    PlayerGui.ChildRemoved:Connect(function(child)
        if child == self.Gui or child == self.ColorGui then
            task.defer(function()
                if child and child.Parent == nil then
                    child.Parent = PlayerGui
                end
            end)
        end
    end)

    -- Drag
    local dragging = false
    local dragStart, startPos

    self.Top.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        dragging = true
        dragStart = input.Position
        startPos = self.Main.Position
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging or input.UserInputType ~=
            Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - dragStart
        self.Main.Position = UDim2.new(startPos.X.Scale,
                                       startPos.X.Offset + delta.X,
                                       startPos.Y.Scale,
                                       startPos.Y.Offset + delta.Y)
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return self
end

function NovaUI:SelectPage(page)
    for _, p in ipairs(self.Pages) do
        p.Frame.Visible = false
        p.Button.BackgroundColor3 = C.Sidebar
        p.Button.TextColor3 = C.SubText
    end
    page.Frame.Visible = true
    page.Button.BackgroundColor3 = C.Accent2
    page.Button.TextColor3 = Color3.new(1, 1, 1)
    self.CurrentPage = page
end

function NovaUI:AddPage(name, icon)
    -- FIX: capture the NovaUI instance before page:AddToggle shadows self
    local ui = self

    local page = {}
    page.Name = name
    page.Icon = icon or name:sub(1, 1)

    page.Frame = New("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 1,
        ScrollBarImageColor3 = C.Border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 12
    })

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 5)
    padding.PaddingLeft = UDim.new(0, 7)
    padding.PaddingRight = UDim.new(0, 7)
    padding.Parent = page.Frame

    New("UIListLayout", {
        Parent = page.Frame,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 3)
    })

    page.Button = New("TextButton", {
        Parent = self.Sidebar,
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = C.Sidebar,
        BorderSizePixel = 0,
        Text = page.Icon,
        TextColor3 = C.SubText,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        ZIndex = 12
    })
    Corner(page.Button, 4)

    page.Button.MouseButton1Click:Connect(function()
        ClosePicker(ui)
        ui:SelectPage(page)
    end)

    table.insert(self.Pages, page)
    if not self.CurrentPage then self:SelectPage(page) end

    -- ================================================================
    -- TITLE
    -- ================================================================
    function page:AddTitle(text)
        ui:EnsureWidth(EstTextWidth(text, 7) + 60)
        return New("TextLabel", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 19),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13
        })
    end

    -- ================================================================
    -- LABEL
    -- ================================================================
    function page:AddLabel(text)
        ui:EnsureWidth(EstTextWidth(text, 5) + 60)
        return New("TextLabel", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.SubText,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13
        })
    end

    -- ================================================================
    -- TOGGLE
    -- ================================================================
    function page:AddToggle(text, default, callback, options)
        options = options or {}

        local enabled = default == true
        local bindEnabled = options.keybind ~= false -- default semua toggle punya keybind; matikan dengan { keybind = false }
        local colorEnabled =
            options.colorpicker == true or options.COLORPICKER == true
        local currentKey = nil
