local Components = {}

local Window = {}
Window.__index = Window

function Window.new(lib, root, body, header, refs)
    return setmetatable({
        Lib = lib,
        Instance = root,
        Body = body,
        Header = header,
        Refs = refs,
        Minimized = false,
    }, Window)
end

function Window:ApplyTheme()
    local theme = self.Lib.Theme

    self.Instance.BackgroundColor3 = theme:Get("Background")
    self.Refs.Header.BackgroundColor3 = theme:Get("Surface")
    self.Refs.Title.TextColor3 = theme:Get("Text")
    self.Refs.Min.TextColor3 = theme:Get("Text")
    self.Refs.Close.TextColor3 = theme:Get("Text")
end

function Window:SetMinimized(value)
    self.Minimized = value == true

    self.Refs.Min.Text = self.Minimized and "+" or "—"

    self.Lib.Animation:Tween(
        self.Body,
        {
            Size = self.Minimized
                and UDim2.new(1, 0, 0, 0)
                or UDim2.new(1, 0, 1, -48)
        }
    )
end

function Window:AddLabel(text)
    local label = Util.Text(
        self.Body,
        text,
        Config.Font,
        13,
        self.Lib.Theme:Get("Muted")
    )

    label.Size = UDim2.new(1, 0, 0, 24)

    return label
end

local function buttonBase(lib, parent, text)
    local theme = lib.Theme
    local animation = lib.Animation

    local button = Util.New("TextButton", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 40),
        Text = text or "Button",
        Font = Config.Font,
        TextSize = 14,
        TextColor3 = theme:Get("Text"),
        BackgroundColor3 = theme:Get("Surface"),
        AutoButtonColor = false,
        BorderSizePixel = 0,
    })

    Util.Corner(button, 8)
    Util.Stroke(button, theme:Get("Border"), .35)

    Util.BindHover(
        button,
        animation,
        {BackgroundColor3 = theme:Get("Surface")},
        {BackgroundColor3 = theme:Get("Surface2")}
    )

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Util.Ripple(
                button,
                input.Position - button.AbsolutePosition
            )
        end
    end)

    return button
end

--[[
    AddButton({
        Text = "Button",
        Style = "Solid" | "Outline" | "Gradient",
        Callback = function() end
    })
]]
function Window:AddButton(config)
    config = config or {}

    local button = buttonBase(
        self.Lib,
        self.Body,
        config.Text
    )

    button.LayoutOrder = config.LayoutOrder or 0

    if config.Style == "Outline" then
        button.BackgroundTransparency = 1
    elseif config.Style == "Gradient" then
        local gradient = Instance.new("UIGradient")
        gradient.Rotation = 90
        gradient.Color = ColorSequence.new(
            self.Lib.Theme:Get("Accent"),
            self.Lib.Theme:Get("Surface")
        )
        gradient.Parent = button
    end

    button.Activated:Connect(function()
        safeCall(config.Callback)
    end)

    return button
end

