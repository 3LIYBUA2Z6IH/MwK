        13,
        theme:Get("Text")
    )

    label.Position = UDim2.fromOffset(12, 9)
    label.Size = UDim2.new(1, -68, 0, 24)

    local track = Util.New("Frame", {
        Parent = row,
        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(1, -52, .5, -11),
        BackgroundColor3 = theme:Get("Surface2"),
        BorderSizePixel = 0,
    })

    Util.Corner(track, 99)

