end

function KeybindListWindow.RefreshList()
    if not KeybindListWindow.List then return end

    for _, child in pairs(KeybindListWindow.List:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    KeybindListWindow.Rows = {}

    local count = 0
    local maxLen = 0
    for _, info in ipairs(KeybindList._config) do
        if info.code ~= nil then -- keybind None -> tidak ditampilkan
            count = count + 1
            maxLen = math.max(maxLen, #info.displayName + #info.code.Name + 3)

            -- row: nama kiri, key ber-bracket kanan -> "nama keybind [E]"
            local row = New("Frame", {
                Parent = KeybindListWindow.List,
                Size = UDim2.new(1, 0, 0, 14),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 52
            })

            local nameLabel = New("TextLabel", {
                Parent = row,
                Size = UDim2.new(1, -68, 1, 0),
                BackgroundTransparency = 1,
                Text = info.displayName,
                TextColor3 = info.on and C.Text or Color3.fromRGB(112, 105, 112),
                TextSize = 9,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 52
            })

            local keyLabel = New("TextLabel", {
                Parent = row,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.new(0, 62, 1, 0),
                BackgroundTransparency = 1,
                Text = "[" .. info.code.Name .. "]",
                TextColor3 = info.on and C.Text or C.SubText,
                TextSize = 9,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 52
            })

            KeybindListWindow.Rows[count] = {
                Name = nameLabel,
                Key = keyLabel,
                Entry = info
            }
        end
    end

    -- lebar window mengikuti panjang teks terpanjang (semua resolusi)
    local width = math.clamp(56 + maxLen * 6, 120, 420)
    KeybindListWindow.List.Size = UDim2.new(1, -16, 0, count * 16)
    KeybindListWindow.Frame.Size = UDim2.new(0, width, 0, 26 + count * 16)
end

-- animasi perubahan warna ON/OFF yang smooth (tanpa rebuild list)
function KeybindListWindow.UpdateColors()
    for _, r in pairs(KeybindListWindow.Rows or {}) do
        local on = r.Entry.on
        TweenService:Create(r.Name, TweenInfo.new(0.18), {
            TextColor3 = on and C.Text or Color3.fromRGB(112, 105, 112)
        }):Play()
        TweenService:Create(r.Key, TweenInfo.new(0.18),
                            {TextColor3 = on and C.Text or C.SubText}):Play()
    end
end

function KeybindListWindow.Destroy()
    if KeybindListWindow.Gui then KeybindListWindow.Gui:Destroy() end
    KeybindListWindow.Gui = nil
    KeybindListWindow.Frame = nil
    KeybindListWindow.List = nil
    KeybindListWindow.Title = nil
    KeybindListWindow.Rows = nil
end

return NovaUI
