        local button = Util.New("TextButton", {
            Parent = holder,
            Size = UDim2.new(1, 0, 0, 32),
            Text = tostring(option),
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Config.Font,
            TextSize = 13,
            TextColor3 = theme:Get("Text"),
            BackgroundTransparency = 1,
            AutoButtonColor = false,
        })

        local dot = Instance.new("Frame")
        dot.Size = UDim2.fromOffset(18, 18)
        dot.Position = UDim2.fromOffset(0, 7)
        dot.BackgroundColor3 = theme:Get("Surface2")
        dot.Parent = button
        Util.Corner(dot, 99)

        local inner = Instance.new("Frame")
        inner.Size = UDim2.fromOffset(10, 10)
        inner.Position = UDim2.fromOffset(4, 4)
        inner.BackgroundColor3 = theme:Get("Accent")
        inner.Parent = dot
        Util.Corner(inner, 99)

        local text = Util.Text(
            button,
            tostring(option),
            Config.Font,
            13,
            theme:Get("Text")
        )

        text.Position = UDim2.fromOffset(28, 4)
        text.Size = UDim2.new(1, -28, 0, 24)

        inner.Visible = option == selected

        button.Activated:Connect(function()
            selected = option

            for _, sibling in ipairs(holder:GetChildren()) do
                if sibling:IsA("TextButton") then
                    local d = sibling:FindFirstChildOfClass("Frame")
                    local i = d and d:FindFirstChildOfClass("Frame")

                    if i then
                        i.Visible = sibling.Text == tostring(selected)
                    end
                end
            end

            safeCall(config.Callback, selected)
        end)
    end

    return {
        Instance = holder,
        Get = function()
            return selected
        end,
        Set = function(_, value)
            selected = value
        end,
    }
end

function Window:AddProgress(config)
    config = config or {}

    local theme = self.Lib.Theme

    local holder = Util.New("Frame", {
        Parent = self.Body,
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
    })

    local label = Util.Text(
        holder,
        config.Text or "",
        Config.Font,
        13,
        theme:Get("Text")
    )

    label.Size = UDim2.new(1, 0, 0, 16)

    local bar = Util.New("Frame", {
        Parent = holder,
        Position = UDim2.fromOffset(0, 24),
        Size = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = theme:Get("Surface2"),
        BorderSizePixel = 0,
    })

    Util.Corner(bar, 99)

    local fill = Util.New("Frame", {
        Parent = bar,
        Size = UDim2.new(
            math.clamp(config.Value or 0, 0, 1),
            0,
            1,
            0
        ),
        BackgroundColor3 = theme:Get("Accent"),
        BorderSizePixel = 0,
    })

    Util.Corner(fill, 99)

    local function set(value)
        value = math.clamp(value, 0, 1)

        self.Lib.Animation:Tween(
            fill,
            {Size = UDim2.new(value, 0, 1, 0)}
        )

        label.Text = (config.Text or "")
            .. " "
            .. math.floor(value * 100)
            .. "%"
    end

    set(config.Value or 0)

    return {
        Instance = holder,
        Set = set,
    }
end

function Window:AddTooltip(target, text)
    assert(
        target and target:IsA("GuiObject"),
        "AstraUI: Tooltip target must be a GuiObject"
    )

    local theme = self.Lib.Theme

    local tooltip = Util.New("TextLabel", {
        Parent = target,
        Visible = false,
        AutomaticSize = Enum.AutomaticSize.XY,
        Text = text or "",
        Font = Config.Font,
        TextSize = 12,
        TextColor3 = theme:Get("Text"),
        BackgroundColor3 = theme:Get("Surface2"),
        BorderSizePixel = 0,
        ZIndex = 100,
    })

    Util.Padding(tooltip, 7)
    Util.Corner(tooltip, 7)

    target.MouseEnter:Connect(function()
        tooltip.Visible = true
    end)

    target.MouseLeave:Connect(function()
        tooltip.Visible = false
    end)

    return tooltip
end

function Window:AddColorPicker(config)
    config = config or {}

    local input = self:AddInput({
        Placeholder = config.Text or "Hex (#RRGGBB)"
    })

    input.Text = config.Default or "#6495ED"

    local function parse(hex)
        hex = tostring(hex):gsub("#", "")

        if #hex ~= 6 then
            return nil
        end

        local number = tonumber(hex, 16)

        if not number then
            return nil
        end

        return Color3.fromRGB(
            math.floor(number / 65536) % 256,
            math.floor(number / 256) % 256,
            number % 256
        )
    end

    input.FocusLost:Connect(function()
        local color = parse(input.Text)

        if color then
            safeCall(config.Callback, color)
        else
            input.TextColor3 = self.Lib.Theme:Get("Error")
        end
    end)

    return input
end

function Window:AddTabGroup(config)
    config = config or {}

    local theme = self.Lib.Theme

    local holder = Util.New("Frame", {
        Parent = self.Body,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundTransparency = 1,
    })

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 5)
    layout.Parent = holder

    local pages = {}

    local function add(name)
        local button = Util.New("TextButton", {
            Parent = holder,
            Size = UDim2.fromOffset(100, 34),
            Text = name,
            Font = Config.Font,
            TextSize = 13,
            TextColor3 = theme:Get("Text"),
            BackgroundColor3 = theme:Get("Surface"),
            AutoButtonColor = false,
        })

        Util.Corner(button, 7)

        local page = Util.New("Frame", {
            Parent = self.Body,
            Visible = false,
            Size = UDim2.new(1, 0, 0, 10),
            BackgroundTransparency = 1,
        })

        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Parent = page
        pageLayout.Padding = UDim.new(0, Config.Spacing)

        button.Activated:Connect(function()
            for _, otherPage in pairs(pages) do
                otherPage.Visible = false
            end

            page.Visible = true
        end)

        pages[name] = page

        return page
    end

    return {
        Instance = holder,
        Add = add,
        Pages = pages,
    }
end

-- =========================================================
-- CORE
-- =========================================================

local Core = {}
Core.__index = Core

function Core.new(lib)
    return setmetatable({
        Lib = lib,
        Gui = nil,
        Blur = nil,
    }, Core)
end

function Core:_ensureGui()
    if self.Gui and self.Gui.Parent then
        return self.Gui
    end

    local playerGui = Util.GetPlayerGui()

    assert(
        playerGui,
        "AstraUI must run on the client"
    )

    local gui = Instance.new("ScreenGui")

    gui.Name = "AstraUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 100

    gui.Parent = playerGui

    self.Gui = gui

    return gui
end

--[[
    CreateWindow(config)
    Returns Window object.
]]
function Core:CreateWindow(config)
    config = config or {}

    local gui = self:_ensureGui()
    local theme = self.Lib.Theme

    local root = Instance.new("Frame")

    root.Name = config.Name or "Window"
    root.Size = config.Size or UDim2.fromOffset(620, 430)
    root.Position = config.Position or UDim2.fromScale(.5, .5)
    root.AnchorPoint = Vector2.new(.5, .5)
    root.BackgroundColor3 = theme:Get("Background")
    root.BorderSizePixel = 0
    root.ClipsDescendants = true
    root.Parent = gui
    root.ZIndex = 1

    Util.Corner(
        root,
        config.CornerRadius or Config.CornerRadius
    )

    local shadow = Instance.new("ImageLabel")

    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://1316045217"
    shadow.ImageTransparency = .45
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(10, 10, 118, 118)
    shadow.Size = UDim2.new(1, 40, 1, 40)
    shadow.Position = UDim2.fromOffset(-20, -20)
    shadow.ZIndex = 0
    shadow.Parent = root

    local header = Util.New("Frame", {
        Parent = root,
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = theme:Get("Surface"),
        BorderSizePixel = 0,
    })

    local title = Util.Text(
        header,
        config.Title or "AstraUI",
        Config.Font,
        16,
        theme:Get("Text")
    )

    title.Position = UDim2.fromOffset(16, 0)
    title.Size = UDim2.new(1, -120, 1, 0)

    local min = Util.New("TextButton", {
        Parent = header,
        Text = "—",
        Font = Config.Font,
        TextSize = 18,
        TextColor3 = theme:Get("Text"),
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(40, 48),
        Position = UDim2.new(1, -84, 0, 0),
    })

    local close = Util.New("TextButton", {
        Parent = header,
        Text = "×",
        Font = Config.Font,
        TextSize = 20,
        TextColor3 = theme:Get("Text"),
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(40, 48),
        Position = UDim2.new(1, -42, 0, 0),
    })

    local body = Util.New("ScrollingFrame", {
        Parent = root,
        Position = UDim2.fromOffset(0, 48),
        Size = UDim2.new(1, 0, 1, -48),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ScrollingDirection = Enum.ScrollingDirection.Y,
    })

    Util.Padding(body, 12)

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, Config.Spacing)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = body

    local resizeGrip = Util.New("TextButton", {
        Parent = root,
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new(1, -18, 1, -18),
        Text = "",
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        ZIndex = 10,
    })

    Util.MakeDraggable(header, root)

    local camera = workspace.CurrentCamera
    local viewport = camera
        and camera.ViewportSize
        or Vector2.new(1280, 720)

    local maxWidth = math.max(320, viewport.X - 24)
    local maxHeight = math.max(260, viewport.Y - 24)

    Util.MakeResizable(
        resizeGrip,
        root,
        Vector2.new(320, 260),
        Vector2.new(maxWidth, maxHeight)
    )

    local window = Window.new(
        self.Lib,
        root,
        body,
        header,
        {
            Title = title,
            Min = min,
            Close = close,
            Resize = resizeGrip,
            Header = header,
        }
    )

    min.Activated:Connect(function()
        window:SetMinimized(not window.Minimized)
    end)

    close.Activated:Connect(function()
        window:Destroy()
    end)

    local themeConnection = self.Lib.Theme.Changed.Event:Connect(function()
        if root.Parent then
            window:ApplyTheme()
        end
    end)

    window._ThemeConnection = themeConnection

    if config.Blur then
        local blur = Instance.new("BlurEffect")

        blur.Name = "AstraUI_Blur"
        blur.Size = math.clamp(
            config.BlurSize or 8,
            0,
            24
        )
        blur.Parent = Lighting

        self.Blur = blur
    end

    return window
end

function Window:Destroy()
    if self._ThemeConnection then
        self._ThemeConnection:Disconnect()
        self._ThemeConnection = nil
    end

    if self.Instance then
        self.Instance:Destroy()
        self.Instance = nil
    end
end

--[[
    Notify(config)
    Type: Toast / Success / Error / Warning
]]
function Core:Notify(config)
    config = config or {}

    local gui = self:_ensureGui()
    local theme = self.Lib.Theme
    local animation = self.Lib.Animation

    local holder = gui:FindFirstChild("Notifications")

    if not holder then
        holder = Util.New("Frame", {
            Name = "Notifications",
            Parent = gui,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -18, 1, -18),
            Size = UDim2.fromOffset(330, 400),
        })

        local list = Instance.new("UIListLayout")
        list.VerticalAlignment = Enum.VerticalAlignment.Bottom
        list.HorizontalAlignment = Enum.HorizontalAlignment.Right
        list.Padding = UDim.new(0, 8)
        list.Parent = holder
    end

    local card = Util.New("Frame", {
        Parent = holder,
        Size = UDim2.new(1, 0, 0, 76),
        BackgroundColor3 = theme:Get("Surface"),
        BorderSizePixel = 0,
    })

    Util.Corner(card, 10)
    Util.Stroke(card, theme:Get("Border"), .25)

    local kind = config.Type or "Toast"

    local accent =
        kind == "Success" and theme:Get("Success")
        or kind == "Error" and theme:Get("Error")
        or kind == "Warning" and theme:Get("Warning")
        or theme:Get("Accent")

    local bar = Util.New("Frame", {
        Parent = card,
        Size = UDim2.fromOffset(4, 76),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
    })

    local heading = Util.Text(
        card,
        config.Title or kind,
        Config.Font,
        14,
        theme:Get("Text")
    )

    heading.Position = UDim2.fromOffset(16, 10)
    heading.Size = UDim2.new(1, -28, 0, 20)

    local description = Util.Text(
        card,
        config.Content or "",
        Config.Font,
        12,
        theme:Get("Muted")
    )

    description.Position = UDim2.fromOffset(16, 32)
    description.Size = UDim2.new(1, -28, 0, 34)

    task.delay(config.Duration or 3, function()
        if card and card.Parent then
            animation:Tween(
                card,
                {BackgroundTransparency = 1}
            )

            task.wait(animation.Duration)

            if card then
                card:Destroy()
            end
        end
    end)

    return card
end

function Core:Destroy()
    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end

    if self.Blur then
        self.Blur:Destroy()
        self.Blur = nil
    end
end

-- =========================================================
-- PUBLIC API
-- =========================================================

--[[
    AstraUI.new(config?)
    Creates a new AstraUI instance.

    Returns:
        AstraUI object
]]
function AstraUI.new(config)
    config = config or {}

    local self = setmetatable({}, AstraUI)

    self.Config = config
    self.Theme = Theme.new(config.Theme)
    self.Animation = Animation.new(config.Animation)
    self.Core = Core.new(self)
    self.Windows = {}

    return self
end

--[[
    UI:CreateWindow(config)
    Creates and returns a Window.
]]
function AstraUI:CreateWindow(config)
    local window = self.Core:CreateWindow(config)

    table.insert(self.Windows, window)

    return window
end

--[[
    UI:SetTheme("Dark")
    UI:SetTheme("Light")
    UI:SetTheme(customPalette)
]]
function AstraUI:SetTheme(theme)
    self.Theme:Set(theme)
end

--[[
    UI:Notify(config)
    Creates an auto-dismissing notification.
]]
function AstraUI:Notify(config)
    return self.Core:Notify(config)
end

function AstraUI:Destroy()
    self.Core:Destroy()

    for _, window in ipairs(self.Windows) do
        if window and window.Destroy then
            pcall(function()
                window:Destroy()
            end)
        end
    end

    table.clear(self.Windows)
    self.Theme:Destroy()
end

return AstraUI
