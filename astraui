-- =========================================================
-- UTILITY
-- =========================================================

local Util = {}

function Util.New(className, props)
    local object = Instance.new(className)
    for key, value in pairs(props or {}) do
        object[key] = value
    end
    return object
end

function Util.Corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
    return c
end

function Util.Stroke(parent, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

function Util.Padding(parent, amount)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, amount)
    p.PaddingBottom = UDim.new(0, amount)
    p.PaddingLeft = UDim.new(0, amount)
    p.PaddingRight = UDim.new(0, amount)
    p.Parent = parent
    return p
end

function Util.Text(parent, text, font, size, color)
    return Util.New("TextLabel", {
        Parent = parent,
        BackgroundTransparency = 1,
        Text = text or "",
        Font = font,
        TextSize = size or 14,
        TextColor3 = color,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
end

function Util.BindHover(button, animation, normal, hover)
    button.MouseEnter:Connect(function()
        animation:Tween(button, hover)
    end)
    button.MouseLeave:Connect(function()
        animation:Tween(button, normal)
    end)
end

function Util.Ripple(button, position)
    local circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(.5, .5)
    circle.Position = UDim2.fromOffset(position.X, position.Y)
    circle.Size = UDim2.fromOffset(0, 0)
    circle.BackgroundColor3 = Color3.new(1, 1, 1)
    circle.BackgroundTransparency = .82
    circle.BorderSizePixel = 0
    circle.ZIndex = button.ZIndex + 1
    circle.Parent = button
    Util.Corner(circle, 999)

    local target = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.8
    local tween = TweenService:Create(
        circle,
        TweenInfo.new(.35, Enum.EasingStyle.Quad),
        {
            Size = UDim2.fromOffset(target, target),
            BackgroundTransparency = 1
        }
    )
    tween:Play()
    tween.Completed:Connect(function()
        if circle then circle:Destroy() end
    end)
end

function Util.MakeDraggable(handle, target)
    local dragging = false
    local dragStart
    local startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = target.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    return UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            target.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

function Util.MakeResizable(grip, target, minSize, maxSize)
    local resizing = false
    local startMouse
    local startSize

    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            resizing = true
            startMouse = input.Position
            startSize = target.AbsoluteSize

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    resizing = false
                end
            end)
        end
    end)

    return UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - startMouse

        local x = math.clamp(
            startSize.X + delta.X,
            minSize.X,
            maxSize.X
        )

        local y = math.clamp(
            startSize.Y + delta.Y,
            minSize.Y,
            maxSize.Y
        )

        target.Size = UDim2.fromOffset(x, y)
    end)
end

function Util.GetPlayerGui()
    local player = Players.LocalPlayer
    if not player then return nil end
    return player:FindFirstChildOfClass("PlayerGui")
end

-- =========================================================
-- ANIMATION
-- =========================================================

local Animation = {}
Animation.__index = Animation

function Animation.new(config)
    config = config or {}

    return setmetatable({
        Enabled = config.Enabled ~= false,
        Duration = config.Duration or .18,
        EasingStyle = config.EasingStyle or Enum.EasingStyle.Quart,
        EasingDirection = config.EasingDirection or Enum.EasingDirection.Out,
    }, Animation)
end

--[[
    Tween(instance, properties, duration?, style?, direction?)
    Returns Tween or nil when animations are disabled.
]]
function Animation:Tween(instance, properties, duration, style, direction)
    if not instance then return nil end

    if not self.Enabled then
        for key, value in pairs(properties) do
            instance[key] = value
        end
        return nil
    end

    local tween = TweenService:Create(
        instance,
        TweenInfo.new(
            duration or self.Duration,
            style or self.EasingStyle,
            direction or self.EasingDirection
        ),
        properties
    )

    tween:Play()
    return tween
end

function Animation:Stop(tween)
    if tween then
        tween:Cancel()
    end
end

-- =========================================================
-- THEME
-- =========================================================

local Theme = {}
Theme.__index = Theme

function Theme.new(initial)
    local self = setmetatable({}, Theme)

    self.Changed = Instance.new("BindableEvent")
    self.Palettes = Config.Colors
    self.CurrentName = initial or Config.Theme or "Dark"
    self.Current = self.Palettes[self.CurrentName] or self.Palettes.Dark

    return self
end

function Theme:Get(key)
    return self.Current[key] or self.Current.Text
end

--[[
    Set("Dark"), Set("Light"), or Set(customPalette)
]]
function Theme:Set(value)
    if type(value) == "string" then
        assert(self.Palettes[value], "AstraUI: Unknown theme: " .. value)

        self.CurrentName = value
        self.Current = self.Palettes[value]

    elseif type(value) == "table" then
        self.CurrentName = "Custom"
        self.Current = value

    else
        error("AstraUI: Theme:Set expects a theme name or palette table")
    end

    self.Changed:Fire(self.Current)
end

function Theme:Destroy()
    if self.Changed then
        self.Changed:Destroy()
        self.Changed = nil
    end
end

-- =========================================================
-- SAFE CALLBACK
-- =========================================================

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local ok, err = xpcall(callback, debug.traceback, ...)

    if not ok then
        warn("[AstraUI] Callback error:\n" .. tostring(err))
    end
end

