            })
            Corner(svButton, 5)
            Stroke(svButton)

            local white = New("Frame", {
                Parent = svButton,
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1001
            })
            Corner(white, 5)
            New("UIGradient", {
                Parent = white,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1)
                })
            })

            local black = New("Frame", {
                Parent = svButton,
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0,
                ZIndex = 1002
            })
            Corner(black, 5)
            New("UIGradient", {
                Parent = black,
                Rotation = 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(1, 0)
                })
            })

            local svCursor = New("Frame", {
                Parent = svButton,
                Size = UDim2.fromOffset(10, 10),
                Position = UDim2.new(sat, 0, 1 - val, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1003
            })
            Corner(svCursor, 5)
            Stroke(svCursor)

            local hueButton = New("TextButton", {
                Parent = popup,
                Size = UDim2.fromOffset(16, 135),
                Position = UDim2.fromOffset(202, 36),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Active = true,
                ZIndex = 1000
            })
            Corner(hueButton, 6)
            Stroke(hueButton)

            New("UIGradient", {
                Parent = hueButton,
                Rotation = 90,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                })
            })

            local hueCursor = New("Frame", {
                Parent = hueButton,
                Size = UDim2.fromOffset(20, 4),
                Position = UDim2.new(0.5, 0, hue, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1003
            })
            Corner(hueCursor, 2)
            Stroke(hueCursor)

            local hexBox = New("TextLabel", {
                Parent = popup,
                Size = UDim2.new(1, -20, 0, 24),
                Position = UDim2.fromOffset(10, 181),
                BackgroundColor3 = C.Element,
                TextColor3 = C.SubText,
                TextSize = 9,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextYAlignment = Enum.TextYAlignment.Center,
                ZIndex = 1001
            })
            Corner(hexBox, 4)
            Stroke(hexBox)

            local draggingSV = false
            local draggingHue = false

            applyColor = function()
                currentColor = Color3.fromHSV(hue, sat, val)
                colorButton.BackgroundColor3 = currentColor
                -- FIX: colorSquare (indikator ON toggle) tidak ikut diubah, tetap putih
                preview.BackgroundColor3 = currentColor
                if options.ColorCallback then
                    pcall(options.ColorCallback, currentColor)
                end
                svButton.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                svCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
                hueCursor.Position = UDim2.new(0.5, 0, hue, 0)
                hexBox.Text = string.format("#%02X%02X%02X", math.floor(
                                                currentColor.R * 255 + 0.5),
                                            math.floor(
                                                currentColor.G * 255 + 0.5),
                                            math.floor(
                                                currentColor.B * 255 + 0.5))
            end

            local function updateSV(input)
                local size = svButton.AbsoluteSize
                if size.X <= 0 or size.Y <= 0 then return end
                sat = Clamp01((input.Position.X - svButton.AbsolutePosition.X) /
                                  size.X)
                val = 1 -
                          Clamp01(
                              (input.Position.Y - svButton.AbsolutePosition.Y) /
                                  size.Y)
                applyColor()
            end

            local function updateHue(input)
                local size = hueButton.AbsoluteSize
                if size.Y <= 0 then return end
                hue = Clamp01(
                          (input.Position.Y - hueButton.AbsolutePosition.Y) /
                              size.Y)
                applyColor()
            end

            svButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV = true
                    updateSV(input)
                end
            end)

            hueButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingHue = true
                    updateHue(input)
                end
            end)

            UIS.InputChanged:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseMovement then
                    return
                end
                if draggingSV then updateSV(input) end
                if draggingHue then updateHue(input) end
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV = false
                    draggingHue = false
                end
            end)

            -- FIX: all self.* → ui.* (self = page inside page:AddToggle)
            colorButton.MouseButton1Click:Connect(function()
                ui.ColorGui.Enabled = true
                if ui.ActiveColorPicker and ui.ActiveColorPicker ~= popup then
                    ui.ActiveColorPicker.Visible = false
                end
                if popup.Visible then
                    popup.Visible = false
                    ui.ActiveColorPicker = nil
                    ui.ActiveColorButton = nil
                    return
                end
                ui.ActiveColorPicker = popup
                ui.ActiveColorButton = colorButton

                local camera = workspace.CurrentCamera
                local viewport = camera and camera.ViewportSize or
                                     Vector2.new(800, 600)
                local bPos = colorButton.AbsolutePosition
                local bSize = colorButton.AbsoluteSize
                local pSize = popup.AbsoluteSize
                if pSize.X <= 0 or pSize.Y <= 0 then
                    pSize = Vector2.new(230, 245)
                end

                local x = bPos.X
                local y = bPos.Y + bSize.Y + 5
                if x + pSize.X > viewport.X - 5 then
                    x = viewport.X - pSize.X - 5
                end
                if x < 5 then x = 5 end
                if y + pSize.Y > viewport.Y - 5 then
                    y = bPos.Y - pSize.Y - 5
                end
                if y < 5 then y = 5 end

                popup.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
                popup.Visible = true
                popup.ZIndex = 1000
                applyColor()
            end)
        end -- end if colorEnabled

        -- ============================================================
        -- KEYBIND (FIX: removed duplicate block — was copy-pasted twice)
        -- ============================================================
        if bindEnabled then
            local bindX = colorEnabled and -89 or -66
            local bindButton = New("TextButton", {
                Parent = holder,
                Size = UDim2.fromOffset(34, 20),
                Position = UDim2.new(1, bindX, 0.5, -10),
                BackgroundColor3 = C.Element,
                BorderSizePixel = 0,
                Text = "None",
                TextColor3 = C.SubText,
                TextSize = 8,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 15
            })
            Corner(bindButton, 4)
            Stroke(bindButton)

            -- AUTO-REGISTER ke KeybindList (pakai nama toggle ini)
            kbEntry = {displayName = text, code = nil, on = enabled}
            KeybindList.AddEntry(kbEntry)

            local function syncEntry()
                kbEntry.code = currentKey
                kbEntry.on = enabled
                if KeybindListWindow.Frame and KeybindListWindow.Frame.Visible then
                    KeybindListWindow.RefreshList()
                end
            end

            local function cancelRecording()
                if not recording then return end
                recording = false
                KeybindList.StopRecording()
                if currentKey then
                    bindButton.Text = currentKey.Name
                    bindButton.TextSize = 8
                    bindButton.TextColor3 = C.Text
                else
                    bindButton.Text = "None"
                    bindButton.TextSize = 8
                    bindButton.TextColor3 = C.SubText
                end
            end

            bindButton.MouseButton1Click:Connect(function()
                if recording then return end
                -- hanya satu toggle yang boleh merekam: batalkan rekaman toggle lain
                if KeybindList.CancelActive then
                    KeybindList.CancelActive()
                    KeybindList.CancelActive = nil
                end
                recording = true
                KeybindList.CancelActive = cancelRecording
                KeybindList.StartRecording()
                bindButton.Text = "Press key..."
                bindButton.TextSize = 7
                bindButton.TextColor3 = C.Text
            end)

            UIS.InputBegan:Connect(function(input, gameProcessed)
                if recording then
                    if input.KeyCode == Enum.KeyCode.Backspace then
                        currentKey = nil
                        bindButton.Text = "None"
                        bindButton.TextSize = 8
                        bindButton.TextColor3 = C.SubText
                        recording = false
                        KeybindList.StopRecording()
                        KeybindList.CancelActive = nil
                        syncEntry() -- None -> tidak tampil di Keybind List
                        return
                    end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        -- Cek: key sudah dipakai toggle lain? -> tolak, suruh pakai key lain
                        local taken = false
                        for _, info in ipairs(KeybindList._config) do
                            if info ~= kbEntry and info.code ~= nil and
                                info.code == input.KeyCode then
                                taken = true
                                break
                            end
                        end
                        if taken then
                            bindButton.Text = "Key dipakai!"
                            bindButton.TextSize = 6
                            bindButton.TextColor3 = Color3.fromRGB(230, 65, 85)
                            -- tetap mode recording -> langsung tekan key lain
                            task.delay(0.6, function()
                                if recording then
                                    bindButton.Text = "Press key..."
                                    bindButton.TextSize = 7
                                    bindButton.TextColor3 = C.Text
                                end
                            end)
                            return
                        end

                        currentKey = input.KeyCode
                        bindButton.Text = currentKey.Name
                        bindButton.TextSize = 8
                        bindButton.TextColor3 = C.Text
                        recording = false
                        KeybindList.StopRecording()
                        KeybindList.CancelActive = nil
                        syncEntry()
                    end
                    return
                end
                -- hotkey tidak aktif selama ada toggle lain yang sedang merekam key
                if KeybindList._recording == 0 and not gameProcessed and
                    currentKey and input.KeyCode == currentKey then
                    enabled = not enabled
                    refreshToggle()
                end
            end)
        end -- end if bindEnabled

        -- ============================================================
        -- SHEET DALAM TOGGLE (opsi: sheet = true)
        -- Tampilan: "> nama toggle" (tanpa balok/block).
        -- Klik ">" -> expand/collapse isi di bawahnya (kayak AddSheet),
        -- tapi toggle di kanan tetap berfungsi normal (on/off terpisah).
        -- ============================================================
        local subSheet = nil
        if options.sheet == true then
            local TWEEN_OPEN = TweenInfo.new(0.28, Enum.EasingStyle.Quint,
                                             Enum.EasingDirection.Out)
            local TWEEN_CLOSE = TweenInfo.new(0.20, Enum.EasingStyle.Quint,
                                              Enum.EasingDirection.In)

            -- panah ">" di kiri nama toggle
            local sheetArrow = New("TextButton", {
                Parent = holder,
                Size = UDim2.fromOffset(14, 20),
                Position = UDim2.new(0, 0, 0.5, -10),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Text = ">",
                TextColor3 = C.SubText,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                AutoButtonColor = false,
                ZIndex = 15
            })

            -- geser nama toggle ke kanan biar tidak ketiban panah
            label.Position = UDim2.fromOffset(16)
            label.Size = UDim2.new(1, -136, 1, 0)
            -- +186 = 166 + 20 indentasi tambahan (toggle bersheet di dalam sheet)
            ui:EnsureWidth(EstTextWidth(text, 7) + 186)

            local subBody = New("Frame", {
                Parent = page.Frame,
                Size = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ClipsDescendants = true,
                Visible = false,
                ZIndex = 13
            })

            local subPad = Instance.new("UIPadding")
            subPad.PaddingLeft = UDim.new(0, 20)
            subPad.PaddingTop = UDim.new(0, 3)
            subPad.Parent = subBody

            local subList = Instance.new("UIListLayout")
            subList.SortOrder = Enum.SortOrder.LayoutOrder
            subList.Padding = UDim.new(0, 3)
            subList.Parent = subBody

            local itemCount = 0

            subSheet = {Count = 0, IsOpen = false}
            subSheet.Body = subBody

            -- sinkron: subBody mengikuti parent & urutan holder
            -- (supaya saat toggle dimasukkan ke AddSheet, isi sheet-nya
            --  ikut pindah + maju ke dalam, bukan sejajar)
            function subSheet.SyncTo(order)
                subBody.LayoutOrder = (order or 0) + 1
                subBody.Parent = holder.Parent
            end

            holder:GetPropertyChangedSignal("Parent"):Connect(function()
                if holder.Parent then
                    subSheet.SyncTo(holder.LayoutOrder)
                end
            end)

            local function subHeight()
                local h = subList.AbsoluteContentSize.Y
                if h <= 0 and itemCount > 0 then
                    h = itemCount * 28
                end
                return h + subPad.PaddingTop.Offset
            end

            -- AUTO-RESIZE: isi sub-sheet berubah (mis. ada sheet bersarang
            -- yang expand) -> tinggi subBody ikut menyesuaikan
            subList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(
                function()
                    if subSheet.IsOpen then
                        local h = subHeight()
                        TweenService:Create(subBody, TweenInfo.new(0.15,
                                                                   Enum.EasingStyle
                                                                       .Quint,
                                                                   Enum.EasingDirection
                                                                       .Out),
                                            {Size = UDim2.new(1, 0, 0, h)})
                            :Play()
                    end
                end)

            local function applyLayout(animate)
                if subSheet.IsOpen then subBody.Visible = true end
                local h = subSheet.IsOpen and subHeight() or 0
                local info = subSheet.IsOpen and TWEEN_OPEN or TWEEN_CLOSE

                if not animate then
                    subBody.Size = UDim2.new(1, 0, 0, h)
                    subBody.Visible = subSheet.IsOpen
                    return
                end

                local t = TweenService:Create(subBody, info,
                                              {Size = UDim2.new(1, 0, 0, h)})
                t:Play()
                TweenService:Create(sheetArrow, info, {
                    Rotation = subSheet.IsOpen and 90 or 0,
                    TextColor3 = subSheet.IsOpen and C.Text or C.SubText
                }):Play()
                if not subSheet.IsOpen then
                    t.Completed:Connect(function()
                        if not subSheet.IsOpen then
                            subBody.Visible = false
                        end
                    end)
                end
            end

            local function track(el)
                itemCount = itemCount + 1
                subSheet.Count = itemCount
                if subSheet.IsOpen then
                    task.defer(function()
                        task.wait()
                        applyLayout(true)
                    end)
                end
                return el
            end

            function subSheet:AddToggle(text, default, callback, opts)
                local el = page:AddToggle(text, default, callback, opts or {})
                el.Holder.Parent = subBody
                return track(el)
            end

            function subSheet:AddSlider(text, min, max, default, callback)
                local el = page:AddSlider(text, min, max, default, callback)
                el.Holder.Parent = subBody
                return track(el)
            end

            function subSheet:AddButton(text, callback)
                local btn = page:AddButton(text, callback)
                btn.Parent = subBody
                return track(btn)
            end

            function subSheet:AddLabel(text)
                local lbl = page:AddLabel(text)
                lbl.Parent = subBody
                return track(lbl)
            end

            function subSheet:AddDropdown(text, options)
                local dd = page:AddDropdown(text, options)
                dd.Holder.Parent = subBody
                return track(dd)
            end

            -- Open + Close digabung jadi satu: Toggle()
            function subSheet:Toggle()
                subSheet.IsOpen = not subSheet.IsOpen
                applyLayout(true)
            end

            function subSheet:Destroy() subBody:Destroy() end

            -- klik ">" untuk buka / tutup isi (terpisah dari state toggle)
            sheetArrow.MouseButton1Click:Connect(function()
                subSheet:Toggle()
            end)
        end

        -- daftarkan ke registry config (untuk Save/Load Configuration)
        table.insert(ui.ConfigItems, {
            Type = "Toggle",
            Name = text,
            Get = function() return enabled end,
            Set = function(v)
                enabled = v == true
                refreshToggle()
            end
        })

        return {
            Set = function(_, state)
                enabled = state == true
                refreshToggle()
            end,
            Get = function() return enabled end,
            GetKey = function() return currentKey end,
            SetColor = function(_, color)
                if typeof(color) ~= "Color3" then return end
                currentColor = color
                colorSquare.BackgroundColor3 = color
                if colorEnabled then
                    local h, s, v = color:ToHSV()
                    hue, sat, val = h, s, v
                    applyColor()
                end
            end,
            GetColor = function() return currentColor end,
            Holder = holder,
            Sheet = subSheet -- opsi sheet = true -> Sub:Sheet:AddToggle/AddSlider dll
        }
    end

    -- ================================================================
    -- BUTTON
    -- ================================================================
    function page:AddButton(text, callback)
        -- Anti-tabrakan: window melebar kalau nama button panjang
        ui:EnsureWidth(EstTextWidth(text, 6) + 170)

        local holder = New("Frame", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 13
        })

        -- label kiri
        local label = New("TextButton", {
            Parent = holder,
            Size = UDim2.new(1, -108, 1, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            AutoButtonColor = false,
