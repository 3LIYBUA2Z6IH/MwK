    -- ================================================================
    -- SLIDER
    -- ================================================================
    function page:AddSlider(text, min, max, default, callback)
        local value = math.clamp(default or min, min, max)

        local holder = New("Frame", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundTransparency = 1,
            ZIndex = 14
        })

        New("TextLabel", {
            Parent = holder,
            Size = UDim2.new(1, -112, 1, 0), -- sisa ruang untuk valuebox + slider
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 15
        })

        ui:EnsureWidth(EstTextWidth(text, 6) + 170)

        local valueBox = New("TextBox", {
            Parent = holder,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -74, 0.5, 0),
            Size = UDim2.fromOffset(30, 18),
            BackgroundColor3 = C.Element,
            Text = tostring(value),
            TextColor3 = C.SubText,
            TextSize = 8,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ClearTextOnFocus = false,
            ZIndex = 15
        })
        Corner(valueBox, 4)
        Stroke(valueBox)

        local bg = New("Frame", {
            Parent = holder,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -4, 0.5, 0),
            Size = UDim2.fromOffset(60, 6),
            BackgroundColor3 = Color3.fromRGB(40, 36, 40),
            ZIndex = 14
        })
        Corner(bg, 6)

        -- fill slider: warna ACCENT (ikut theme)
        local fill = New("Frame", {
            Parent = bg,
            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = C.Accent,
            ZIndex = 15
        })
        Corner(fill, 6)

        -- knob bulatan di ujung fill slider ( ----o ) — warna ACCENT
        local knob = New("Frame", {
            Parent = bg,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = C.Accent,
            BorderSizePixel = 0,
            ZIndex = 16
        })
        Corner(knob, 6)

        local knobStroke = Instance.new("UIStroke")
        knobStroke.Color = C.Background
        knobStroke.Thickness = 2
        knobStroke.Parent = knob

        local draggingSlider = false

        local function setValue(v, fire)
            v = tonumber(v)
            if not v then
                valueBox.Text = tostring(value);
                return
            end
            value = math.clamp(v, min, max)
            if min % 1 == 0 and max % 1 == 0 then
                value = math.floor(value + 0.5)
            end
            valueBox.Text = tostring(value)
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            knob.Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0)
            if fire and callback then callback(value) end
        end

        local function slide(input)
            local size = bg.AbsoluteSize.X
            if size <= 0 then return end
            local pos = Clamp01((input.Position.X - bg.AbsolutePosition.X) /
                                    size)
            setValue(min + pos * (max - min), true)
        end

        valueBox.FocusLost:Connect(function()
            setValue(valueBox.Text, true)
        end)

        bg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = true
                slide(input)
            end
        end)

        -- FIX: drag juga bisa mulai dari knob-nya langsung
        knob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = true
                slide(input)
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if draggingSlider and input.UserInputType ==
                Enum.UserInputType.MouseMovement then slide(input) end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = false
            end
        end)

        -- daftarkan ke registry config (untuk Save/Load Configuration)
        table.insert(ui.ConfigItems, {
            Type = "Slider",
            Name = text,
            Get = function() return value end,
            Set = function(v) setValue(v, false) end
        })

        return {
            Set = function(_, v) setValue(v, false) end,
            Get = function() return value end,
            Holder = holder
        }
    end

    -- ================================================================
    -- DROPDOWN
    --   Mode              [ Normal ▼ ]
    --                       ┌──────────────┐
    --                       │ Normal       │
    --                       │ Aggressive   │
    --                       └──────────────┘
    -- ================================================================
    function page:AddDropdown(text, options)
        options = options or {}

        local choices = options.Options or options.options or {}
        local current = options.Default or options.default or choices[1] or ""
        local callback = options.Callback or options.callback
        local open = false

        local holder = New("Frame", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 13
        })

        -- Anti-tabrakan: window melebar kalau nama dropdown panjang
        ui:EnsureWidth(EstTextWidth(text, 6) + 180)

        local label = New("TextLabel", {
            Parent = holder,
            Size = UDim2.new(1, -130, 1, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 14
        })

        local DD_W = 120
        local ddButton = New("TextButton", {
            Parent = holder,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -4, 0.5, 0),
            Size = UDim2.fromOffset(DD_W, 20),
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = tostring(current) .. "  ▼",
            TextColor3 = C.Text,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 15
        })
        Corner(ddButton, 4)
        Stroke(ddButton)

        -- popup list di ui.Content supaya tidak terpotong ScrollingFrame;
        -- posisi dihitung dari AbsolutePosition
        local popup = New("Frame", {
            Parent = ui.Content,
            Size = UDim2.fromOffset(DD_W, 0),
            BackgroundColor3 = C.Background,
            BorderSizePixel = 0,
            Visible = false,
            ClipsDescendants = true,
            ZIndex = 900
        })
        Corner(popup, 4)
        Stroke(popup)

        local function popHeight() return #choices * 16 + 6 end

        local function setSelected(v, fire)
            current = v
            ddButton.Text = tostring(v) .. "  " .. (open and "▲" or "▼")
            if fire and callback then callback(v) end
        end

        local setOpen -- forward declare

        local function buildOptions()
            for _, c in pairs(popup:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            for i, choice in ipairs(choices) do
                local opt = New("TextButton", {
                    Parent = popup,
                    Position = UDim2.new(0, 4, 0, (i - 1) * 16 + 3),
                    Size = UDim2.new(1, -8, 0, 16),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Text = tostring(choice),
                    TextColor3 = (choice == current) and C.Accent or C.Text,
                    TextSize = 9,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    ZIndex = 901
                })
                opt.MouseEnter:Connect(function()
                    opt.BackgroundColor3 = C.ElementHover
                    opt.BackgroundTransparency = 0
                end)
                opt.MouseLeave:Connect(function()
                    opt.BackgroundTransparency = 1
                end)
                opt.MouseButton1Click:Connect(function()
                    setSelected(choice, true) -- pilih 1 opsi -> ganti value + callback
                    setOpen(false) -- otomatis tutup
                end)
            end
        end

        local function positionPopup()
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
            local rel = ddButton.AbsolutePosition - ui.Content.AbsolutePosition
            local ph = popHeight()

            local x = rel.X + ddButton.AbsoluteSize.X - DD_W -- rata kanan dengan tombol
            local y = rel.Y + ddButton.AbsoluteSize.Y + 4 -- tepat di bawah tombol

            -- kalau mepet bawah layar, buka ke atas supaya tidak terpotong
            local absBottom = ddButton.AbsolutePosition.Y +
                                  ddButton.AbsoluteSize.Y + 4 + ph
            if absBottom > vp.Y - 6 then
                y = math.max(0, rel.Y - ph - 4)
            end

            popup.Position = UDim2.fromOffset(math.max(0, math.floor(x)),
                                              math.floor(y))
        end

        function setOpen(v, animate)
            open = v
            ddButton.Text = tostring(current) .. "  " ..
                                (open and "▲" or "▼")
            if open then
                buildOptions()
                positionPopup()
                popup.Visible = true
                if animate == false then
                    popup.Size = UDim2.fromOffset(DD_W, popHeight())
                else
                    popup.Size = UDim2.fromOffset(DD_W, 0)
                    TweenService:Create(popup, TweenInfo.new(0.15,
                                                             Enum.EasingStyle
                                                                 .Quint,
                                                             Enum.EasingDirection
                                                                 .Out), {
                        Size = UDim2.fromOffset(DD_W, popHeight())
                    }):Play()
                end
            else
                local t = TweenService:Create(popup, TweenInfo.new(0.12,
                                                                   Enum.EasingStyle
                                                                       .Quint,
                                                                   Enum.EasingDirection
                                                                       .In), {
                    Size = UDim2.fromOffset(DD_W, 0)
                })
                t:Play()
                t.Completed:Connect(function()
                    if not open then popup.Visible = false end
                end)
            end
        end

        ddButton.MouseButton1Click:Connect(function() setOpen(not open) end)

        -- klik di luar popup / tombol -> tutup
        UIS.InputBegan:Connect(function(input, gp)
            if not open or gp then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end

            local p = input.Position
            local pp, ps = popup.AbsolutePosition, popup.AbsoluteSize
            local bp, bs = ddButton.AbsolutePosition, ddButton.AbsoluteSize

            local inPop = p.X >= pp.X and p.X <= pp.X + ps.X and p.Y >= pp.Y and
                              p.Y <= pp.Y + ps.Y
            local inBtn = p.X >= bp.X and p.X <= bp.X + bs.X and p.Y >= bp.Y and
                              p.Y <= bp.Y + bs.Y
            if not inPop and not inBtn then setOpen(false) end
        end)

        -- daftarkan ke registry config (untuk Save/Load Configuration)
        table.insert(ui.ConfigItems, {
            Type = "Dropdown",
            Name = text,
            Get = function() return current end,
            Set = function(v) setSelected(v, false) end
        })

        return {
            Set = function(_, v)
                for _, c in ipairs(choices) do
                    if c == v then
                        setSelected(v, false)
                        return
                    end
                end
            end,
            Get = function() return current end,
            Holder = holder
        }
    end

    -- ================================================================
    -- SHEET (lembar):  > (nama lembar)
    --                      Toggle
    --                      Slider
    -- ================================================================
    function page:AddSheet(name, options)
        options = options or {}

        local sheet = {}
        sheet.Name = name or "Sheet"
        sheet.IsOpen = options.open == true
        sheet.Count = 0

        local HEADER_H = 22
        local TWEEN_OPEN = TweenInfo.new(options.animTime or 0.28,
                                         Enum.EasingStyle.Quint,
                                         Enum.EasingDirection.Out)
        local TWEEN_CLOSE = TweenInfo.new(options.animTime or 0.20,
                                          Enum.EasingStyle.Quint,
                                          Enum.EasingDirection.In)

        -- wrapper: item di list page, tingginya di-tween supaya elemen bawahnya ikut bergeser
        local wrapper = New("Frame", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, HEADER_H),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 13
        })
        sheet.Holder = wrapper

        -- ---------- header: tombol >  +  nama lembar ----------
        local header = New("TextButton", {
            Parent = wrapper,
            Size = UDim2.new(1, 0, 0, HEADER_H),
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 14
        })
        Corner(header, 4)
        Stroke(header)

        local arrow = New("TextLabel", {
            Parent = header,
            Size = UDim2.fromOffset(HEADER_H, HEADER_H),
            BackgroundTransparency = 1,
            Text = ">",
            TextColor3 = C.Text,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 15
        })

        local headerLabel = New("TextLabel", {
            Parent = header,
            Size = UDim2.new(1, -(HEADER_H + 8), 1, 0),
            Position = UDim2.fromOffset(HEADER_H + 2, 0),
            BackgroundTransparency = 1,
            Text = sheet.Name,
            TextColor3 = C.Text,
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 15
        })

        ui:EnsureWidth(14 + HEADER_H + 8 + EstTextWidth(sheet.Name, 6))

        -- ---------- body: list elemen (diindent, tidak sejajar nama lembar) ----------
        local body = New("Frame", {
            Parent = wrapper,
            Position = UDim2.new(0, 0, 0, HEADER_H),
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            Visible = sheet.IsOpen,
            ZIndex = 13
        })
        sheet.Body = body

        local bodyPad = Instance.new("UIPadding")
        bodyPad.PaddingLeft = UDim.new(0, 20)
        bodyPad.PaddingTop = UDim.new(0, 3)
        bodyPad.Parent = body

        local bodyList = Instance.new("UIListLayout")
        bodyList.SortOrder = Enum.SortOrder.LayoutOrder
        bodyList.Padding = UDim.new(0, 3)
        bodyList.Parent = body

        local function bodyHeight()
            local h = bodyList.AbsoluteContentSize.Y
            if h <= 0 and sheet.Count > 0 then h = sheet.Count * 28 end
            return h + bodyPad.PaddingTop.Offset
        end

        -- AUTO-RESIZE: kalau isi sheet berubah (mis. sub-sheet di dalam
        -- toggle-nya expand), tinggi body + wrapper ikut menyesuaikan
        bodyList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(
            function()
                if sheet.IsOpen then
                    local h = bodyHeight()
                    local info = TweenInfo.new(0.15, Enum.EasingStyle.Quint,
                                               Enum.EasingDirection.Out)
                    TweenService:Create(body, info,
                                        {Size = UDim2.new(1, 0, 0, h)}):Play()
                    TweenService:Create(wrapper, info, {
                        Size = UDim2.new(1, 0, 0, HEADER_H + h)
                    }):Play()
                end
            end)

        local function applyLayout(animate)
            -- pastikan body kelihatan dulu supaya ukuran kontennya kebaca saat diukur
            if sheet.IsOpen then body.Visible = true end

            local h = (sheet.IsOpen and bodyHeight()) or 0
            local bodySz = UDim2.new(1, 0, 0, h)
            local wrapSz = UDim2.new(1, 0, 0, HEADER_H + h)
            local info = sheet.IsOpen and TWEEN_OPEN or TWEEN_CLOSE

            header.BackgroundColor3 = sheet.IsOpen and C.ElementHover or
                                          C.Element

            if not animate then
                body.Size = bodySz
                wrapper.Size = wrapSz
                arrow.Rotation = sheet.IsOpen and 90 or 0
                body.Visible = sheet.IsOpen
                return
            end

            local bodyTween = TweenService:Create(body, info, {Size = bodySz})
            bodyTween:Play()
            TweenService:Create(wrapper, info, {Size = wrapSz}):Play()
            TweenService:Create(arrow, info,
                                {Rotation = sheet.IsOpen and 90 or 0}):Play()

            if not sheet.IsOpen then
                bodyTween.Completed:Connect(function()
                    if not sheet.IsOpen then
                        body.Visible = false
                    end
                end)
            end
        end

        -- ---------- buka / tutup dari luar ----------
        local function animateRefresh()
            if not sheet.IsOpen then return end
            task.defer(function()
                task.wait()
                applyLayout(true)
            end)
        end

        -- Open + Close digabung jadi satu: Toggle()
        -- kalau lembar terbuka  -> Toggle() = tutup
        -- kalau lembar tertutup -> Toggle() = buka
        function sheet:Toggle()
            sheet.IsOpen = not sheet.IsOpen
            applyLayout(true)
        end

        function sheet:Destroy() wrapper:Destroy() end

        -- ---------- klik tombol > untuk buka / tutup ----------
        header.MouseButton1Click:Connect(function() sheet:Toggle() end)
        header.MouseEnter:Connect(function()
            header.BackgroundColor3 = C.ElementHover
        end)
        header.MouseLeave:Connect(function()
            header.BackgroundColor3 = sheet.IsOpen and C.ElementHover or
                                          C.Element
        end)

        -- ---------- cara nambah elemen ke dalam lembar ----------
        local function track(el)
            sheet.Count = sheet.Count + 1
            -- Title/Label/Button mengembalikan Instance, Toggle/Slider/Dropdown
            -- mengembalikan table dengan .Holder — dua-duanya diberi LayoutOrder
            if typeof(el) == "table" and el.Holder then
                el.Holder.LayoutOrder = sheet.Count
            elseif typeof(el) == "Instance" then
                el.LayoutOrder = sheet.Count
            end
            animateRefresh()
            return el
        end

        function sheet:AddToggle(text, default, callback, opts)
            local el = page:AddToggle(text, default, callback, opts or {})
            el.Holder.Parent = body
            track(el)
            -- kalau toggle ini punya sheet, sinkronkan isi-nya:
            -- parent ikut body + urutan tepat di bawah toggle-nya
            if el.Sheet and el.Sheet.SyncTo then
                el.Sheet.SyncTo(el.Holder.LayoutOrder)
            end
            return el
        end

        function sheet:AddSlider(text, min, max, default, callback)
            local el = page:AddSlider(text, min, max, default, callback)
            el.Holder.Parent = body
            return track(el)
        end

        function sheet:AddButton(text, callback)
            local btn = page:AddButton(text, callback)
            btn.Parent = body
            return track(btn)
        end

        function sheet:AddLabel(text)
            local lbl = page:AddLabel(text)
            lbl.Parent = body
            return track(lbl)
        end

        function sheet:AddDropdown(text, options)
            local dd = page:AddDropdown(text, options)
            dd.Holder.Parent = body
            return track(dd)
        end

        function sheet:AddTitle(text)
            local ttl = page:AddTitle(text)
            ttl.Parent = body
            return track(ttl)
        end

        if sheet.IsOpen then
            task.defer(function()
                task.wait()
                applyLayout(true)
            end)
        end

        return sheet
    end

    return page
end

function NovaUI:Toggle()
    self.Gui.Enabled = not self.Gui.Enabled
    if not self.Gui.Enabled then ClosePicker(self) end
end

