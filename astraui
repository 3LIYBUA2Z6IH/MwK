            })
            Corner(popup, 6)
            Stroke(popup)

            local header = New("Frame", {
                Parent = popup,
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1,
                Active = true,
                ZIndex = 1001
            })

            New("TextLabel", {
                Parent = header,
                Size = UDim2.new(1, -40, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = "Color Picker",
                TextColor3 = C.Text,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 1002
            })

            local closePicker = New("TextButton", {
                Parent = header,
                Size = UDim2.fromOffset(25, 24),
                Position = UDim2.new(1, -29, 0, 3),
                BackgroundTransparency = 1,
                Text = "×",
                TextColor3 = C.SubText,
                TextSize = 15,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false,
                ZIndex = 1002
            })

            -- FIX: was ClosePicker(self) — self = page, wrong object
            closePicker.MouseButton1Click:Connect(function()
                ClosePicker(ui)
            end)

            -- FIX: popup color picker sekarang bisa di-drag lewat header
            local draggingPopup = false
            local popupDragStart = nil
            local popupStartPos = nil

            header.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                    return
                end
                draggingPopup = true
                popupDragStart = input.Position
                popupStartPos = popup.Position
            end)

            UIS.InputChanged:Connect(function(input)
                if not draggingPopup then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement then
                    return
                end
                local delta = input.Position - popupDragStart
                popup.Position = UDim2.new(popupStartPos.X.Scale,
                                           popupStartPos.X.Offset + delta.X,
                                           popupStartPos.Y.Scale,
                                           popupStartPos.Y.Offset + delta.Y)
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingPopup = false
                end
