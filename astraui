function Window:AddInput(config)
    config = config or {}

    local theme = self.Lib.Theme

    local input = Util.New("TextBox", {
        Parent = self.Body,
        Size = UDim2.new(1, 0, 0, 40),
        Text = "",
        PlaceholderText = config.Placeholder or "",
        ClearTextOnFocus = false,
        Font = Config.Font,
        TextSize = 14,
        TextColor3 = theme:Get("Text"),
        PlaceholderColor3 = theme:Get("Muted"),
        BackgroundColor3 = theme:Get("Surface"),
        BorderSizePixel = 0,
    })

    Util.Corner(input, 8)
    Util.Padding(input, 12)

    input.TextEditable = config.TextEditable ~= false

    if config.Password then
        input.TextEditable = true
        input.TextXAlignment = Enum.TextXAlignment.Left
        -- Roblox TextBox does not provide a secure password mode through
        -- a universal property in every runtime version. Keep this API
        -- compatible rather than relying on an unstable property.
    end

    local function validate(text)
        if type(config.Validator) ~= "function" then
            return true
        end

        local ok, result = xpcall(
            config.Validator,
            debug.traceback,
            text
        )

        if not ok then
            warn("[AstraUI] Validator error:\n" .. tostring(result))
            return false
        end

        return result ~= false
    end

    input.FocusLost:Connect(function()
        if not validate(input.Text) then
            input.TextColor3 = theme:Get("Error")
        else
            input.TextColor3 = theme:Get("Text")
            safeCall(config.Callback, input.Text)
        end
    end)

    return input
end

function Window:AddSlider(config)
    config = config or {}

    local theme = self.Lib.Theme

    local minimum = config.Min or 0
    local maximum = config.Max or 100

    assert(
        maximum > minimum,
        "AstraUI: Slider Max must be greater than Min"
    )

    local row = Util.New("Frame", {
        Parent = self.Body,
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundTransparency = 1,
    })

    local title = Util.Text(
        row,
        config.Text or "Slider",
        Config.Font,
        13,
        theme:Get("Text")
    )

    title.Size = UDim2.new(1, -70, 0, 24)

    local valueLabel = Util.Text(
        row,
        tostring(config.Default or minimum),
        Config.Font,
        13,
        theme:Get("Muted")
    )

    valueLabel.Position = UDim2.new(1, -60, 0, 0)
    valueLabel.Size = UDim2.fromOffset(60, 24)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Util.New("Frame", {
        Parent = row,
        Position = UDim2.fromOffset(0, 34),
        Size = UDim2.new(1, 0, 0, 6),
        BackgroundColor3 = theme:Get("Surface2"),
        BorderSizePixel = 0,
    })

    Util.Corner(bar, 99)

    local fill = Util.New("Frame", {
        Parent = bar,
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = theme:Get("Accent"),
        BorderSizePixel = 0,
    })

    Util.Corner(fill, 99)

    local knob = Util.New("Frame", {
        Parent = bar,
        AnchorPoint = Vector2.new(.5, .5),
        Position = UDim2.fromScale(0, .5),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = theme:Get("Text"),
        BorderSizePixel = 0,
    })

    Util.Corner(knob, 99)

    local state = config.Default or minimum

    local function set(value, fire)
        state = math.clamp(value, minimum, maximum)

        local alpha = (state - minimum) / (maximum - minimum)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, .5, 0)
        valueLabel.Text = tostring(math.floor(state * 100) / 100)

        if fire then
            safeCall(config.Callback, state)
        end
    end

    local function update(x)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X)
            / math.max(bar.AbsoluteSize.X, 1),
            0,
            1
        )

        set(
            minimum + (maximum - minimum) * alpha,
            true
        )
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            and UserInputService:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton1
            ) then

            update(input.Position.X)
        end
    end)

    set(state, false)

    return {
        Instance = row,
        Get = function()
            return state
        end,
        Set = function(_, value)
            set(value, true)
        end,
    }
end

function Window:AddDropdown(config)
    config = config or {}

    local theme = self.Lib.Theme

    local holder = Util.New("Frame", {
        Parent = self.Body,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = theme:Get("Surface"),
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })

    Util.Corner(holder, 8)

    local main = Util.New("TextButton", {
        Parent = holder,
        Size = UDim2.new(1, 0, 0, 40),
        Text = config.Text or "Select",
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Config.Font,
        TextSize = 14,
        TextColor3 = theme:Get("Text"),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
    })

    Util.Padding(main, 12)

    local list = Util.New("ScrollingFrame", {
        Parent = holder,
        Position = UDim2.fromOffset(0, 40),
        Size = UDim2.new(1, 0, 0, 140),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
    })

    local layout = Instance.new("UIListLayout")
    layout.Parent = list

    local selected = {}

    local function refresh()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for _, option in ipairs(config.Options or {}) do
            local button = Util.New("TextButton", {
                Parent = list,
                Size = UDim2.new(1, -8, 0, 30),
                Text = tostring(option),
                Font = Config.Font,
                TextSize = 13,
                TextColor3 = theme:Get("Text"),
                BackgroundColor3 = selected[option]
                    and theme:Get("Surface2")
                    or theme:Get("Surface"),
                AutoButtonColor = false,
            })

            button.Activated:Connect(function()
                if config.Multi then
                    selected[option] = not selected[option]
                else
                    table.clear(selected)
                    selected[option] = true
                end

                local output = {}

                for key, value in pairs(selected) do
                    if value then
                        table.insert(output, key)
                    end
                end

                main.Text = #output > 0
                    and table.concat(output, ", ")
                    or (config.Text or "Select")

                safeCall(
                    config.Callback,
                    config.Multi and output or output[1]
                )

                if not config.Multi then
                    holder.Size = UDim2.new(1, 0, 0, 40)
                end

                refresh()
            end)
        end

        list.CanvasSize = UDim2.fromOffset(
            0,
            layout.AbsoluteContentSize.Y
        )
    end

    main.Activated:Connect(function()
        local open = holder.AbsoluteSize.Y > 40

        holder.Size = UDim2.new(
            1,
            0,
            0,
            open and 40 or 180
        )
    end)

    refresh()

    return {
        Instance = holder,
        Get = function()
            return selected
        end,
    }
end

