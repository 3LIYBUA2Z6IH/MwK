        if fire then
            safeCall(config.Callback, state)
        end
    end

    row.Activated:Connect(function()
        set(not state, true)
    end)

    set(state, false)

    return {
        Instance = row,
        Get = function()
            return state
        end,
        Set = function(_, value)
            set(value, true)
