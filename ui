function NovaUI:AddPage(name, icon)

    local page = {}

    page.Name = name
    page.Icon = icon or string.sub(name, 1, 1)

    ------------------------------------------------
    -- FRAME
    ------------------------------------------------

    page.Frame = New("ScrollingFrame", {
        Parent = self.Content,

        Size = UDim2.fromScale(1, 1),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ScrollBarThickness = 1,
        ScrollBarImageColor3 = C.Border,

        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,

        Visible = false
    })

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 5)
    padding.PaddingLeft = UDim.new(0, 7)
    padding.PaddingRight = UDim.new(0, 7)
    padding.Parent = page.Frame

    local layout = New("UIListLayout", {
        Parent = page.Frame,

        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 3)
    })

    ------------------------------------------------
    -- PAGE BUTTON
    ------------------------------------------------

    page.Button = New("TextButton", {

        Parent = self.Sidebar,

        Size = UDim2.fromOffset(31, 31),

        BackgroundColor3 = C.Sidebar,
        BorderSizePixel = 0,

        Text = page.Icon,

        TextColor3 = C.SubText,
        TextSize = 10,
        Font = Enum.Font.GothamBold,

        AutoButtonColor = false
    })

    Corner(page.Button, 4)

    page.Button.MouseButton1Click:Connect(function()
        self:SelectPage(page)
    end)

    table.insert(self.Pages, page)

    if not self.CurrentPage then
        self:SelectPage(page)
    end

    ------------------------------------------------
    -- TITLE
    ------------------------------------------------

    function page:AddTitle(text)

        local obj = New("TextLabel", {

            Parent = page.Frame,

            Size = UDim2.new(1, 0, 0, 19),

            BackgroundTransparency = 1,

            Text = text,

            TextColor3 = C.Text,
            TextSize = 12,

            Font = Enum.Font.GothamBold,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        return obj
    end

    ------------------------------------------------
    -- LABEL
    ------------------------------------------------

    function page:AddLabel(text)

        local obj = New("TextLabel", {

            Parent = page.Frame,

            Size = UDim2.new(1, 0, 0, 20),

            BackgroundTransparency = 1,

            Text = text,

            TextColor3 = C.SubText,
            TextSize = 9,

            Font = Enum.Font.GothamMedium,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        return obj
    end

    ------------------------------------------------
    -- TOGGLE + KEYBIND
    ------------------------------------------------

    function page:AddToggle(text, default, callback, options)

        options = options or {}

        local enabled = default or false

        local bindEnabled = options.keybind == true
        local currentKey = nil
        local recording = false

        local holder = New("Frame", {

            Parent = page.Frame,

            Size = UDim2.new(1, 0, 0, 22),

            BackgroundColor3 = C.Element,
            BorderSizePixel = 0
        })

        Corner(holder, 4)

        ------------------------------------------------
        -- TEXT
        ------------------------------------------------

        local label = New("TextLabel", {

            Parent = holder,

            Size = UDim2.new(
                1,
                bindEnabled and -68 or -39,
                1,
                0
            ),

            Position = UDim2.fromOffset(7, 0),

            BackgroundTransparency = 1,

            Text = text,

            TextColor3 = C.Text,
            TextSize = 9,

            Font = Enum.Font.GothamMedium,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        ------------------------------------------------
        -- TOGGLE
        ------------------------------------------------

        local toggle = New("TextButton", {

            Parent = holder,

            Size = UDim2.fromOffset(22, 12),

            Position = UDim2.new(
                1,
                -28,
                0.5,
                -6
            ),

            BackgroundColor3 = Color3.fromRGB(35,35,40),

            BorderSizePixel = 0,

            Text = "",

            AutoButtonColor = false
        })

        Corner(toggle, 8)

        local knob = New("Frame", {

            Parent = toggle,

            Size = UDim2.fromOffset(7, 7),

            Position = UDim2.fromOffset(2, 2),

            BackgroundColor3 = C.SubText,

            BorderSizePixel = 0
        })

        Corner(knob, 10)

        ------------------------------------------------
        -- UPDATE TOGGLE
        ------------------------------------------------

        local function updateToggle()

            if enabled then

                TweenService:Create(
                    toggle,
                    TweenInfo.new(0.12),
                    {
                        BackgroundColor3 = C.Accent
                    }
                ):Play()

                TweenService:Create(
                    knob,
                    TweenInfo.new(0.12),
                    {
                        Position = UDim2.fromOffset(13, 2),
                        BackgroundColor3 =
                            Color3.fromRGB(255,255,255)
                    }
                ):Play()

            else

                TweenService:Create(
                    toggle,
                    TweenInfo.new(0.12),
                    {
                        BackgroundColor3 =
                            Color3.fromRGB(35,35,40)
                    }
                ):Play()

                TweenService:Create(
                    knob,
                    TweenInfo.new(0.12),
                    {
                        Position = UDim2.fromOffset(2, 2),
                        BackgroundColor3 = C.SubText
                    }
                ):Play()

            end

            if callback then
                callback(enabled)
            end

        end

        toggle.MouseButton1Click:Connect(function()

            enabled = not enabled

            updateToggle()

        end)

        ------------------------------------------------
        -- KEYBIND
        ------------------------------------------------

        local bindButton

        if bindEnabled then

            bindButton = New("TextButton", {

                Parent = holder,

                Size = UDim2.fromOffset(28, 16),

                Position = UDim2.new(
                    1,
                    -60,
                    0.5,
                    -8
                ),

                BackgroundColor3 = C.Background,

                BorderSizePixel = 0,

                Text = "None",

                TextColor3 = C.SubText,
                TextSize = 8,

                Font = Enum.Font.GothamMedium,

                AutoButtonColor = false
            })

            Corner(bindButton, 3)

            Stroke(bindButton)

            bindButton.MouseButton1Click:Connect(function()

                if recording then
                    return
                end

                recording = true

                bindButton.Text = "..."

                bindButton.TextColor3 = C.Text

            end)

            UIS.InputBegan:Connect(function(input, gameProcessed)

                if gameProcessed then
                    return
                end

                ----------------------------------------
                -- RECORD KEY
                ----------------------------------------

                if recording then

                    if input.KeyCode == Enum.KeyCode.Backspace then

                        currentKey = nil

                        bindButton.Text = "None"

                        bindButton.TextColor3 =
                            C.SubText

                        recording = false

                        return
                    end

                    if input.UserInputType ==
                        Enum.UserInputType.Keyboard then

                        currentKey = input.KeyCode

                        bindButton.Text =
                            currentKey.Name

                        bindButton.TextColor3 =
                            C.Text

                        recording = false

                    end

                    return
                end

                ----------------------------------------
                -- ACTIVATE KEYBIND
                ----------------------------------------

                if currentKey
                    and input.KeyCode == currentKey then

                    enabled = not enabled

                    updateToggle()

                end

            end)

        end

        ------------------------------------------------
        -- RETURN
        ------------------------------------------------

        return {

            Set = function(_, state)

                enabled = state
                updateToggle()

            end,

            Get = function()

                return enabled

            end,

            GetKey = function()

                return currentKey

            end

        }

    end

    ------------------------------------------------
    -- BUTTON
    ------------------------------------------------

    function page:AddButton(text, callback)

        local button = New("TextButton", {

            Parent = page.Frame,

            Size = UDim2.new(1, 0, 0, 31),

            BackgroundColor3 = C.Element,

            BorderSizePixel = 0,

            Text = text,

            TextColor3 = C.Text,
            TextSize = 9,

            Font = Enum.Font.GothamMedium,

            AutoButtonColor = false
        })

        Corner(button, 4)

        button.MouseEnter:Connect(function()

            button.BackgroundColor3 =
                C.ElementHover

        end)

        button.MouseLeave:Connect(function()

            button.BackgroundColor3 =
                C.Element

        end)

        button.MouseButton1Click:Connect(function()

            if callback then
                callback()
            end

        end)

        return button

    end

    ------------------------------------------------
    -- SLIDER
    ------------------------------------------------

    function page:AddSlider(text, min, max, default, callback)

        local value = math.clamp(default or min, min, max)

        local holder = New("Frame", {

            Parent = page.Frame,

            Size = UDim2.new(1, 0, 0, 38),

            BackgroundColor3 = C.Element,

            BorderSizePixel = 0
        })

        Corner(holder, 4)

        ------------------------------------------------
        -- TITLE
        ------------------------------------------------

        local label = New("TextLabel", {

            Parent = holder,

            Size = UDim2.new(1, -55, 0, 16),

            Position = UDim2.fromOffset(7, 2),

            BackgroundTransparency = 1,

            Text = text,

            TextColor3 = C.Text,
            TextSize = 9,

            Font = Enum.Font.GothamMedium,

            TextXAlignment = Enum.TextXAlignment.Left
        })

        ------------------------------------------------
        -- VALUE INPUT
        ------------------------------------------------

        local valueBox = New("TextBox", {

            Parent = holder,

            Size = UDim2.fromOffset(40, 16),

            Position = UDim2.new(1, -47, 0, 2),

            BackgroundColor3 = C.Background,
            BorderSizePixel = 0,

            Text = tostring(value),

            TextColor3 = C.SubText,
            TextSize = 8,

            Font = Enum.Font.GothamMedium,

            ClearTextOnFocus = false,
            TextEditable = true,
            TextXAlignment = Enum.TextXAlignment.Right
        })

        Corner(valueBox, 3)
        Stroke(valueBox)

        ------------------------------------------------
        -- BAR
        ------------------------------------------------

        local bar = New("Frame", {

            Parent = holder,

            Size = UDim2.new(1, -14, 0, 3),

            Position = UDim2.fromOffset(7, 27),

            BackgroundColor3 =
                Color3.fromRGB(38,38,43),

            BorderSizePixel = 0
        })

        Corner(bar, 3)

        ------------------------------------------------
        -- FILL
        ------------------------------------------------

        local percent =
            (value - min) / (max - min)

        local fill = New("Frame", {

            Parent = bar,

            Size = UDim2.new(percent, 0, 1, 0),

            BackgroundColor3 = C.Accent,

            BorderSizePixel = 0
        })

        Corner(fill, 3)

        ------------------------------------------------
        -- KNOB "o"
        ------------------------------------------------

        local knob = New("Frame", {

            Parent = bar,

            Size = UDim2.fromOffset(8, 8),

            AnchorPoint = Vector2.new(0.5, 0.5),

            Position = UDim2.new(
                percent,
                0,
                0.5,
                0
            ),

            BackgroundColor3 = C.Text,

            BorderSizePixel = 0,

            ZIndex = 2
        })

        Corner(knob, 8)

        ------------------------------------------------
        -- SLIDER UPDATE
        ------------------------------------------------

        local function setValue(newValue, fireCallback)

            newValue = tonumber(newValue)

            if not newValue then
                valueBox.Text = tostring(value)
                return
            end

            value = math.clamp(math.floor(newValue), min, max)

            local p =
                (value - min) /
                (max - min)

            valueBox.Text = tostring(value)

            fill.Size =
                UDim2.new(p, 0, 1, 0)

            knob.Position =
                UDim2.new(
                    p,
                    0,
                    0.5,
                    0
                )

            if fireCallback and callback then
                callback(value)
            end

        end

        ------------------------------------------------
        -- MANUAL VALUE EDIT
        ------------------------------------------------

        valueBox.FocusLost:Connect(function()
            setValue(valueBox.Text, true)
        end)

        ------------------------------------------------
        -- SLIDER INPUT
        ------------------------------------------------

        local dragging = false

        local function update(input)

            local percent = math.clamp(

                (
                    input.Position.X -
                    bar.AbsolutePosition.X
                ) / bar.AbsoluteSize.X,

                0,
                1
            )

            local newValue =
                min + ((max - min) * percent)

            setValue(newValue, true)

        end

        bar.InputBegan:Connect(function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1 then

                dragging = true

                update(input)

            end

        end)

        UIS.InputChanged:Connect(function(input)

            if dragging and input.UserInputType ==
                Enum.UserInputType.MouseMovement then

                update(input)

            end

        end)

        UIS.InputEnded:Connect(function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1 then

                dragging = false

            end

        end)

        return {

            Set = function(_, newValue)
                setValue(newValue, false)
            end,

            Get = function()
                return value
            end

        }

    end

    return page
end

