    local Nav=New("ScrollingFrame",{Parent=SB,BackgroundTransparency=1,Position=UDim2.new(0,10,0,80),Size=UDim2.new(1,-20,1,-160),BorderSizePixel=0,ScrollBarThickness=0,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(0,0,0,0)},{New("UIListLayout",{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder})})
    local Content=New("Frame",{Parent=Main,BackgroundTransparency=1,Position=UDim2.new(0,190,0,10),Size=UDim2.new(1,-200,1,-20)})
    local Header=New("Frame",{Parent=Content,BackgroundTransparency=1,Size=UDim2.new(1,0,0,60)})
    New("TextLabel",{Parent=Header,BackgroundTransparency=1,Size=UDim2.new(0,200,0,30),Font=Enum.Font.GothamBold,Text="Hello, "..LocalPlayer.DisplayName,TextColor3=Theme.Text,TextSize=24,TextXAlignment=Enum.TextXAlignment.Left})
    New("TextLabel",{Parent=Header,BackgroundTransparency=1,Position=UDim2.new(0,0,0,30),Size=UDim2.new(0,200,0,20),Font=Enum.Font.Gotham,Text=wsub,TextColor3=Theme.SubText,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})

    local SBX
    local SearchBar=New("Frame",{Parent=Header,BackgroundColor3=Theme.Input,Position=UDim2.new(1,-200,0,10),Size=UDim2.new(0,200,0,35)},{New("UICorner",{CornerRadius=UDim.new(0,8)}),New("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(0,35,1,0),Text="🔍",TextColor3=Theme.SubText,TextSize=14,Font=Enum.Font.Gotham})})
    SBX=New("TextBox",{Parent=SearchBar,BackgroundTransparency=1,Position=UDim2.new(0,35,0,0),Size=UDim2.new(1,-40,1,0),Font=Enum.Font.Gotham,PlaceholderText="Search",Text="",TextColor3=Theme.Text,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false})

    local function Search(txt)
        txt=txt:lower()
        local ap=nil for n,pg in pairs(Pages) do if pg.Visible then ap=pg break end end
        if not ap then return end
        local pd=PageColumns[ap] if not pd then return end
        local function fl(lst)
            if not lst then return end
            for _,pn in pairs(lst:GetChildren()) do
                if pn:IsA("Frame") then
                    local found=false
                    local t=pn:FindFirstChild("Title") if t and t:IsA("TextLabel") and t.Text:lower():find(txt) then found=true end
                    local c=pn:FindFirstChild("Container")
                    if c then for _,item in pairs(c:GetChildren()) do if item:IsA("Frame") then local it=item:FindFirstChild("ItemName") if it and it.Text:lower():find(txt) then item.Visible=true found=true elseif it then item.Visible=false end end end end
                    pn.Visible=found or (txt=="")
                end
            end
        end
        fl(pd.LeftCol) fl(pd.RightCol)
    end
    SBX:GetPropertyChangedSignal("Text"):Connect(function() Search(SBX.Text) end)

    local function AnimCont(cont,show)
        if not cont then return end
        local n=0 for _,c in pairs(cont:GetChildren()) do if c:IsA("TextButton") then n+=1 end end
        local h=(n*30)+(math.max(0,n-1)*2)+5
        if show then cont.Visible=true TweenService:Create(cont,TweenInfo.new(0.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Size=UDim2.new(1,0,0,h)}):Play()
        else TweenService:Create(cont,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Size=UDim2.new(1,0,0,0)}):Play() end
    end

    local function Switch(name,isSub)
        local function Anim(target)
            for n,pg in pairs(Pages) do
                if n==target then pg.Visible=true pg.GroupTransparency=1 pg.Position=UDim2.new(0,0,0,90) TweenService:Create(pg,TweenInfo.new(0.4,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{GroupTransparency=0,Position=UDim2.new(0,0,0,70)}):Play()
                else pg.Visible=false end
            end
        end
        if not isSub then
            if CT==name and SubTabContainers[name] then return end
            CT=name
            for n,btn in pairs(Tabs) do
                local a=(n==name)
                TweenService:Create(btn,TweenInfo.new(0.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{BackgroundTransparency=a and 0 or 1,BackgroundColor3=a and Theme.Accent or Color3.new(1,1,1)}):Play()
                if btn:FindFirstChild("Content") then TweenService:Create(btn.Content,TweenInfo.new(0.3),{TextColor3=a and Theme.Text or Color3.fromRGB(120,120,120)}):Play() end
                if SubTabContainers[n] then AnimCont(SubTabContainers[n],a) end
            end
            if not SubTabContainers[name] then Anim(name) SBX.Text=""
            else
                local sc=SubTabContainers[name]
                if sc then for _,c in pairs(sc:GetChildren()) do if c:IsA("TextButton") then local pl=c:FindFirstChild("PageId") if pl then Switch(pl.Text,true) end break end end end
            end
        else
            CS=name
            for n,btn in pairs(SubTabs) do
                local pl=btn:FindFirstChild("PageId") local pid=pl and pl.Text or "" local a=(pid==name)
                if btn:FindFirstChild("Content") then TweenService:Create(btn.Content,TweenInfo.new(0.3),{TextColor3=a and Theme.Text or Color3.fromRGB(140,140,140)}):Play() end
                if btn:FindFirstChild("Indicator") then TweenService:Create(btn.Indicator,TweenInfo.new(0.3),{BackgroundTransparency=a and 0 or 1,Size=a and UDim2.fromOffset(3,18) or UDim2.fromOffset(2,14)}):Play() end
            end
            Anim(name) SBX.Text=""
        end
    end

    local function MakePage(name)
        local pg=New("CanvasGroup",{Name=name,Parent=Content,BackgroundTransparency=1,Position=UDim2.new(0,0,0,70),Size=UDim2.new(1,0,1,-70),Visible=false,GroupTransparency=1,ClipsDescendants=true,BorderSizePixel=0})
        local sc=New("ScrollingFrame",{Parent=pg,BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),CanvasSize=UDim2.new(0,0,0,0),ScrollBarThickness=0,AutomaticCanvasSize=Enum.AutomaticSize.Y})
        local L=New("Frame",{Parent=sc,BackgroundTransparency=1,Size=UDim2.new(0.48,0,1,0)},{New("UIListLayout",{Padding=UDim.new(0,15),SortOrder=Enum.SortOrder.LayoutOrder})})
        local R=New("Frame",{Parent=sc,BackgroundTransparency=1,Position=UDim2.new(0.52,0,0,0),Size=UDim2.new(0.48,0,1,0)},{New("UIListLayout",{Padding=UDim.new(0,15),SortOrder=Enum.SortOrder.LayoutOrder})})
        Pages[name]=pg PageColumns[pg]={LeftCol=L,RightCol=R}
        return L,R
    end

    -- Window API
    local W={}

    -- Modern API:
    -- local Window = Library:Window({Name=..., SubName=..., MenuKeybind=...})
    -- local Page = Window:Page({Name=..., Icon=...})
    -- local Section = Page:Section({Name=..., Side=1})
    local function ExtendSection(section)
        -- Toggle:
        --   keybind = false -> normal mouse toggle
        --   keybind = true  -> toggle + editable keybind in the same row
        function section:Toggle(cfg)
            cfg=cfg or {}

            local useKey=cfg.keybind
            if useKey==nil then useKey=cfg.Keybind end

            if useKey then
                local obj=self:AddKey(cfg.Name or "Toggle",{
                    key=cfg.Key or cfg.DefaultKey or Enum.KeyCode.Unknown,
                    state=cfg.Default or false,
                    mode=cfg.Mode or "Toggle",
                    callback=cfg.Callback,
                    onlyToggle=cfg.OnlyToggle
                })
                return obj
            end

            local obj=self:AddToggle(cfg.Name or "Toggle",cfg.Default or false,cfg.Callback)
            function obj:Keybind(_)
                -- `keybind` is intended to be decided at creation time.
                return self
            end
            return obj
        end

        function section:Slider(cfg)
            cfg=cfg or {}
            return self:AddSlider(
                cfg.Name or "Slider",
                cfg.Min or 0,
                cfg.Max or 100,
                cfg.Default or 0,
                cfg.Callback
            )
        end

        function section:Dropdown(cfg)
            cfg=cfg or {}
            local options={}
            for _,v in ipairs(cfg.Items or {}) do
                table.insert(options,{text=tostring(v),value=v})
            end
            return self:AddDropdown(cfg.Name or "Dropdown",options,cfg.Callback)
        end

        function section:Keybind(cfg)
            cfg=cfg or {}
            return self:AddKeybind(cfg.Name or "Keybind",cfg.Default,cfg.Callback)
        end

        function section:Colorpicker(cfg)
            cfg=cfg or {}
            return self:AddESPToggle(cfg.Name or "Color",cfg.Default or Color3.new(1,1,1),function(_,color)
                if cfg.Callback then cfg.Callback(color,1) end
            end)
        end

        return section
    end

    function W:Page(cfgOrName)
        cfgOrName=cfgOrName or {}
        local cfgPage=type(cfgOrName)=="table" and cfgOrName or {Name=tostring(cfgOrName)}
        local name=cfgPage.Name or "Page"

        if Pages[name] then
            local existing={}
            local cols=PageColumns[Pages[name]]
            function existing:Section(secCfg)
                secCfg=secCfg or {}
                local side=secCfg.Side or 1
                local col=(side=="Right" or side=="right" or side==2) and cols.RightCol or cols.LeftCol
                return ExtendSection(MakePanel(col,secCfg.Name or "Section"))
            end
            existing.Name=name
            existing.Icon=cfgPage.Icon
            return existing
        end

        -- Reuse the legacy tab creator so the modern Page is also visible in the sidebar.
        local T=W:CreateTab(name,false,cfgPage.Icon)
        local cols=PageColumns[Pages[name]]
        local P={Name=name,Icon=cfgPage.Icon}

        function P:Section(secCfg)
            secCfg=secCfg or {}
            local side=secCfg.Side or 1
            local col=(side=="Right" or side=="right" or side==2) and cols.RightCol or cols.LeftCol
            return ExtendSection(MakePanel(col,secCfg.Name or "Section"))
        end

        P.AddSection=P.Section
        return P
    end

    function W:SetMenuKeybind(newKey)
        wkey=newKey or Enum.KeyCode.Unknown
        if MenuInputConnection then
            MenuInputConnection:Disconnect()
            MenuInputConnection=nil
        end
        if wkey~=Enum.KeyCode.Unknown then
            MenuInputConnection=UserInputService.InputBegan:Connect(function(i,gp)
                if gp then return end
                if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==wkey then
                    vis=not vis
                    TM(vis)
                end
            end)
        end
        return wkey
    end

    function W:GetMenuKeybind()
        return wkey
    end

    function W:CreateSettingsPage(_window)
        local page=W:Page({Name="Config"})
        local sec=page:Section({Name="Menu",Side=1})

        sec:AddKeybind("Hide / Show Menu",wkey,function(k)
            W:SetMenuKeybind(k)
        end)

        return page
    end


    function W:CreateTab(name, hasSub, icon)
        local btn=New("TextButton",{Parent=Nav,BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=1,Size=UDim2.new(1,0,0,40),Text="",AutoButtonColor=false},{New("UICorner",{CornerRadius=UDim.new(0,8)})})
        btn.MouseButton1Click:Connect(function() Switch(name) end)
        if icon then
            New("ImageLabel",{Name="Icon",Parent=btn,BackgroundTransparency=1,Position=UDim2.new(0,10,0.5,-8),Size=UDim2.fromOffset(16,16),Image=tostring(icon)})
        end
        New("TextLabel",{Name="Content",Parent=btn,BackgroundTransparency=1,Position=UDim2.new(0,icon and 34 or 15,0,0),Size=UDim2.new(1,-(icon and 34 or 15),1,0),Font=Enum.Font.GothamBold,Text=name,TextColor3=Color3.fromRGB(120,120,120),TextSize=14,TextXAlignment=Enum.TextXAlignment.Left})
        Tabs[name]=btn

        local T={}

        if hasSub then
            local sc=New("Frame",{Name=name.."_Sub",Parent=Nav,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),ClipsDescendants=true,Visible=false},{New("UIListLayout",{Padding=UDim.new(0,2),SortOrder=Enum.SortOrder.LayoutOrder}),New("UIPadding",{PaddingLeft=UDim.new(0,10)})})
            SubTabContainers[name]=sc

            function T:CreateSubTab(subName, pid)
                local id=pid or subName
                local sb=New("TextButton",{Parent=sc,BackgroundTransparency=1,Size=UDim2.new(1,0,0,30),Text="",AutoButtonColor=false})
                New("TextLabel",{Name="PageId",Parent=sb,Visible=false,Text=id})
                New("Frame",{Name="Indicator",Parent=sb,BackgroundColor3=Theme.Accent,Position=UDim2.new(0,5,0.5,-7),Size=UDim2.fromOffset(2,14),BackgroundTransparency=1},{New("UICorner",{CornerRadius=UDim.new(0,2)})})
                New("TextLabel",{Name="Content",Parent=sb,BackgroundTransparency=1,Position=UDim2.new(0,25,0,0),Size=UDim2.new(1,-25,1,0),Font=Enum.Font.GothamMedium,Text=subName,TextColor3=Color3.fromRGB(140,140,140),TextSize=13,TextXAlignment=Enum.TextXAlignment.Left})
                sb.MouseButton1Click:Connect(function() Switch(id,true) end)
                SubTabs[id]=sb
                local L,R=MakePage(id)
                local ST={}
                function ST:AddPanel(title,side)
                    local col=(side=="Right" or side=="right" or side==2) and R or L
                    return MakePanel(col,title)
                end
                return ST
            end
        else
            local L,R=MakePage(name)
            function T:AddPanel(title,side)
                local col=(side=="Right" or side=="right" or side==2) and R or L
                return MakePanel(col,title)
            end
        end

        return T
    end

    function W:Init(first)
        Switch(first)
    end

    -- Hide/Show Menu key
    local atw=nil
    TM=function(s)
        if atw then atw:Cancel() end
        if s then
            LastMB=UserInputService.MouseBehavior LastMI=UserInputService.MouseIconEnabled
            UserInputService.MouseBehavior=Enum.MouseBehavior.Default UserInputService.MouseIconEnabled=true
            Main.Visible=true
            atw=TweenService:Create(Main,TweenInfo.new(0.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{GroupTransparency=0}) atw:Play()
        else
            UserInputService.MouseBehavior=LastMB UserInputService.MouseIconEnabled=LastMI
            atw=TweenService:Create(Main,TweenInfo.new(0.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{GroupTransparency=1}) atw:Play()
            atw.Completed:Connect(function(st) if st==Enum.PlaybackState.Completed and not vis then Main.Visible=false end end)
        end
    end

    local function ConnectMenuKey()
        if MenuInputConnection then MenuInputConnection:Disconnect() MenuInputConnection=nil end
        if wkey~=Enum.KeyCode.Unknown then
            MenuInputConnection=UserInputService.InputBegan:Connect(function(i,gp)
                if gp then return end
                if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==wkey then
                    vis=not vis
                    TM(vis)
                end
            end)
        end
    end
    ConnectMenuKey()

    -- Avatar
    task.spawn(function()
        repeat task.wait() until LocalPlayer and LocalPlayer.DisplayName~=nil
        local ok,img=pcall(function() return Players:GetUserThumbnailAsync(LocalPlayer.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size420x420) end)
        if not ok then img="rbxasset://textures/ui/GuiImagePlaceholder.png" end
        New("Frame",{Parent=SB,BackgroundColor3=Theme.Input,Size=UDim2.new(0,160,0,50),Position=UDim2.new(0,10,1,-70),ZIndex=10},{New("UICorner",{CornerRadius=UDim.new(0,8)}),New("ImageLabel",{BackgroundColor3=Theme.Divider,Image=img,Position=UDim2.new(0,5,0,5),Size=UDim2.fromOffset(40,40),ZIndex=11},{New("UICorner",{CornerRadius=UDim.new(0,6)}),New("UIStroke",{Color=Theme.Accent,Thickness=1})}),New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,55,0,5),Size=UDim2.new(0,95,0,20),Font=Enum.Font.GothamBold,Text=LocalPlayer.DisplayName,TextColor3=Theme.Text,TextSize=14,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=11}),New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,55,0,25),Size=UDim2.new(0,95,0,20),Font=Enum.Font.Gotham,Text="Member",TextColor3=Theme.SubText,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11})})
    end)

    -- Intro
    LastMB=UserInputService.MouseBehavior LastMI=UserInputService.MouseIconEnabled
    UserInputService.MouseBehavior=Enum.MouseBehavior.Default UserInputService.MouseIconEnabled=true
    Main.Size=UDim2.new(0,750,0,0) Main.Visible=true
    TweenService:Create(Main,TweenInfo.new(0.6,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(750,550),GroupTransparency=0}):Play()

    return W
end

