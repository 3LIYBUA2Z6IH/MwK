    Draggable(Main,Main)

    local Pages,PageColumns,Tabs,SubTabContainers,SubTabs={},{},{},{},{}
    local CT,CS=nil,nil
    local MenuInputConnection=nil
    local vis=true
    local TM

    local SB=New("Frame",{Parent=Main,BackgroundColor3=Theme.Sidebar,Size=UDim2.new(0,180,1,0),ZIndex=2},{New("UICorner",{CornerRadius=UDim.new(0,10)}),New("Frame",{BackgroundColor3=Theme.Sidebar,BorderSizePixel=0,Position=UDim2.new(1,-5,0,0),Size=UDim2.new(0,5,1,0),ZIndex=2})})
