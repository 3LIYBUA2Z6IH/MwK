    local self = setmetatable({}, NovaUI)
    self.Pages = {}
    self.CurrentPage = nil
    self.ActiveColorPicker = nil
    self.ActiveColorButton = nil

    self.Gui = New("ScreenGui", {
        Name = "NovaUI_Main",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100000,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        Parent = PlayerGui
    })

    self.ColorGui = New("ScreenGui", {
        Name = "NovaUI_ColorPicker",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100001,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        Parent = PlayerGui
    })

    self.Main = New("Frame", {
        Parent = self.Gui,
        Size = UDim2.fromOffset(220, 300),
        Position = UDim2.new(0.5, -110, 0.5, -150),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        ZIndex = 10
    })
    Corner(self.Main, 5)
    Stroke(self.Main)

    self.Top = New("Frame", {
        Parent = self.Main,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = C.Top,
        BorderSizePixel = 0,
        ZIndex = 11
    })

    New("TextLabel", {
        Parent = self.Top,
        Size = UDim2.new(1, -45, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = title or "Nova",
        TextColor3 = C.Text,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12
    })

    local close = New("TextButton", {
        Parent = self.Top,
        Size = UDim2.fromOffset(25, 24),
        Position = UDim2.new(1, -29, 0, 3),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = C.SubText,
        TextSize = 16,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        ZIndex = 12
    })

    close.MouseButton1Click:Connect(function()
        self.Gui.Enabled = false
        ClosePicker(self)
    end)

    self.Sidebar = New("Frame", {
        Parent = self.Main,
        Size = UDim2.new(0, 35, 1, -30),
        Position = UDim2.fromOffset(0, 30),
        BackgroundColor3 = C.Sidebar,
        BorderSizePixel = 0,
        ZIndex = 11
    })

    New("UIListLayout", {
        Parent = self.Sidebar,
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Padding = UDim.new(0, 4)
    })

    local sidePadding = Instance.new("UIPadding")
    sidePadding.PaddingTop = UDim.new(0, 7)
    sidePadding.Parent = self.Sidebar

    self.Content = New("Frame", {
        Parent = self.Main,
        Size = UDim2.new(1, -35, 1, -30),
        Position = UDim2.fromOffset(35, 30),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        ZIndex = 11
    })

    local dragging = false
    local dragStart
    local startPos

    self.Top.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        dragging = true
        dragStart = input.Position
        startPos = self.Main.Position
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local delta = input.Position - dragStart
        self.Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return self
end

function NovaUI:SelectPage(page)
    for _, p in ipairs(self.Pages) do
        p.Frame.Visible = false
        p.Button.BackgroundColor3 = C.Sidebar
        p.Button.TextColor3 = C.SubText
    end

    page.Frame.Visible = true
    page.Button.BackgroundColor3 = C.Accent2
    page.Button.TextColor3 = Color3.new(1, 1, 1)
    self.CurrentPage = page
end

function NovaUI:AddPage(name, icon)
    local page = {}
    page.Name = name
    page.Icon = icon or name:sub(1, 1)

    page.Frame = New("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 1,
        ScrollBarImageColor3 = C.Border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 12
    })

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 5)
    padding.PaddingLeft = UDim.new(0, 7)
    padding.PaddingRight = UDim.new(0, 7)
    padding.Parent = page.Frame

    New("UIListLayout", {
        Parent = page.Frame,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 3)
    })

    page.Button = New("TextButton", {
        Parent = self.Sidebar,
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = C.Sidebar,
        BorderSizePixel = 0,
        Text = page.Icon,
        TextColor3 = C.SubText,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        ZIndex = 12
    })
    Corner(page.Button, 4)

    page.Button.MouseButton1Click:Connect(function()
        ClosePicker(self)
        self:SelectPage(page)
    end)

    table.insert(self.Pages, page)
    if not self.CurrentPage then
        self:SelectPage(page)
    end

    function page:AddTitle(text)
        return New("TextLabel", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 19),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13
        })
    end

    function page:AddLabel(text)
        return New("TextLabel", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.SubText,
            TextSize = 9,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 13
        })
    end

    function page:AddToggle(text, default, callback, options)
        options = options or {}

        local enabled = default == true
        local bindEnabled = options.keybind == true or options.KEYBIND == true
        local colorEnabled = options.colorpicker == true or options.COLORPICKER == true
        local currentKey = nil
        local recording = false
        local currentColor = options.color or options.Color or C.Accent

        local holder = New("Frame", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 13
        })

        local label = New("TextLabel", {
            Parent = holder,
            Size = UDim2.new(0, 92, 1, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = enabled and C.Text or C.SubText,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 14
        })

        local toggleButton = New("TextButton", {
            Parent = holder,
            Size = UDim2.fromOffset(21, 21),
            Position = UDim2.new(1, -21, 0.5, -10.5),
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 15
        })
        Corner(toggleButton, 4)

        local colorSquare = New("Frame", {
            Parent = toggleButton,
            BackgroundColor3 = currentColor,
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = enabled and UDim2.fromOffset(14, 14) or UDim2.fromOffset(0, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = 16
        })
        Corner(colorSquare, 2)

        local function refreshToggle()
            TweenService:Create(colorSquare, TweenInfo.new(0.12), {
                Size = enabled and UDim2.fromOffset(14, 14) or UDim2.fromOffset(0, 0),
                BackgroundColor3 = currentColor
            }):Play()
            label.TextColor3 = enabled and C.Text or C.SubText
            if callback then
                callback(enabled)
            end
        end

        toggleButton.MouseButton1Click:Connect(function()
            enabled = not enabled
            refreshToggle()
        end)

        local colorButton
        local popup
        local hue, sat, val
        local applyColor

        if colorEnabled then
            colorButton = New("TextButton", {
                Parent = holder,
                Size = UDim2.fromOffset(20, 20),
                Position = UDim2.new(1, -47, 0.5, -10),
                BackgroundColor3 = currentColor,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Active = true,
                Selectable = false,
                ZIndex = 30
            })
            Corner(colorButton, 4)
            Stroke(colorButton)

            popup = New("Frame", {
                Parent = self.ColorGui,
                Size = UDim2.fromOffset(230, 245),
                BackgroundColor3 = C.Top,
                BorderSizePixel = 0,
                Visible = false,
                Active = true,
                ZIndex = 1000
            })
            Corner(popup, 6)
            Stroke(popup)

            local header = New("Frame", {
                Parent = popup,
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1,
                ZIndex = 1001
            })

            New("TextLabel", {
                Parent = header,
                Size = UDim2.new(1, -40, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = "Color Picker",
                TextColor3 = C.Text,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 1002
            })

            local closePicker = New("TextButton", {
                Parent = header,
                Size = UDim2.fromOffset(25, 24),
                Position = UDim2.new(1, -29, 0, 3),
                BackgroundTransparency = 1,
                Text = "×",
                TextColor3 = C.SubText,
                TextSize = 15,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false,
                ZIndex = 1002
            })

            closePicker.MouseButton1Click:Connect(function()
                ClosePicker(self)
            end)

            local preview = New("Frame", {
                Parent = popup,
                Size = UDim2.fromOffset(48, 24),
                Position = UDim2.new(1, -60, 0, 3),
                BackgroundColor3 = currentColor,
                BorderSizePixel = 0,
                ZIndex = 1001
            })
            Corner(preview, 4)
            Stroke(preview)

            hue, sat, val = currentColor:ToHSV()

            local svButton = New("TextButton", {
                Parent = popup,
                Size = UDim2.fromOffset(185, 135),
                Position = UDim2.fromOffset(10, 36),
                BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Active = true,
                ZIndex = 1000
            })
            Corner(svButton, 5)
            Stroke(svButton)

            local white = New("Frame", {
                Parent = svButton,
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1001
            })
            Corner(white, 5)
            New("UIGradient", {
                Parent = white,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1)
                })
            })

            local black = New("Frame", {
                Parent = svButton,
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0,
                ZIndex = 1002
            })
            Corner(black, 5)
            New("UIGradient", {
                Parent = black,
                Rotation = 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(1, 0)
                })
            })

            local svCursor = New("Frame", {
                Parent = svButton,
                Size = UDim2.fromOffset(10, 10),
                Position = UDim2.new(sat, 0, 1 - val, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1003
            })
            Corner(svCursor, 5)
            Stroke(svCursor)

            local hueButton = New("TextButton", {
                Parent = popup,
                Size = UDim2.fromOffset(16, 135),
                Position = UDim2.fromOffset(202, 36),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Active = true,
                ZIndex = 1000
            })
            Corner(hueButton, 6)
            Stroke(hueButton)

            New("UIGradient", {
                Parent = hueButton,
                Rotation = 90,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                })
            })

            local hueCursor = New("Frame", {
                Parent = hueButton,
                Size = UDim2.fromOffset(20, 4),
                Position = UDim2.new(0.5, 0, hue, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1003
            })
            Corner(hueCursor, 2)
            Stroke(hueCursor)

            local hexBox = New("TextLabel", {
                Parent = popup,
                Size = UDim2.new(1, -20, 0, 24),
                Position = UDim2.fromOffset(10, 181),
                BackgroundColor3 = C.Element,
                TextColor3 = C.SubText,
                TextSize = 9,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextYAlignment = Enum.TextYAlignment.Center,
                ZIndex = 1001
            })
            Corner(hexBox, 4)
            Stroke(hexBox)

            local draggingSV = false
            local draggingHue = false

            applyColor = function()
                currentColor = Color3.fromHSV(hue, sat, val)
                colorButton.BackgroundColor3 = currentColor
                colorSquare.BackgroundColor3 = currentColor
                preview.BackgroundColor3 = currentColor
                svButton.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                svCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
                hueCursor.Position = UDim2.new(0.5, 0, hue, 0)
                hexBox.Text = string.format(
                    "#%02X%02X%02X",
                    math.floor(currentColor.R * 255 + 0.5),
                    math.floor(currentColor.G * 255 + 0.5),
                    math.floor(currentColor.B * 255 + 0.5)
                )
            end

            local function updateSV(input)
                local size = svButton.AbsoluteSize
                if size.X <= 0 or size.Y <= 0 then
                    return
                end
                sat = Clamp01((input.Position.X - svButton.AbsolutePosition.X) / size.X)
                val = 1 - Clamp01((input.Position.Y - svButton.AbsolutePosition.Y) / size.Y)
                applyColor()
            end

            local function updateHue(input)
                local size = hueButton.AbsoluteSize
                if size.Y <= 0 then
                    return
                end
                hue = Clamp01((input.Position.Y - hueButton.AbsolutePosition.Y) / size.Y)
                applyColor()
            end

            svButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV = true
                    updateSV(input)
                end
            end)

            hueButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingHue = true
                    updateHue(input)
                end
            end)

            UIS.InputChanged:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseMovement then
                    return
                end
                if draggingSV then
                    updateSV(input)
                end
                if draggingHue then
                    updateHue(input)
                end
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV = false
                    draggingHue = false
                end
            end)

            colorButton.MouseButton1Click:Connect(function()
                if self.ActiveColorPicker and self.ActiveColorPicker ~= popup then
                    self.ActiveColorPicker.Visible = false
                end

                if popup.Visible then
                    ClosePicker(self)
                    return
                end

                self.ActiveColorButton = colorButton
                self.ActiveColorPicker = popup
                PlacePopup(colorButton, popup)
                popup.Visible = true
            end)

            applyColor()
        end

        if bindEnabled then
            local bindX = colorEnabled and -89 or -47
            local bindButton = New("TextButton", {
                Parent = holder,
                Size = UDim2.fromOffset(34, 20),
                Position = UDim2.new(1, bindX, 0.5, -10),
                BackgroundColor3 = C.Element,
                BorderSizePixel = 0,
                Text = "None",
                TextColor3 = C.SubText,
                TextSize = 8,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 15
            })
            Corner(bindButton, 4)
            Stroke(bindButton)

            bindButton.MouseButton1Click:Connect(function()
                if recording then
                    return
                end
                recording = true
                bindButton.Text = "Press key..."
                bindButton.TextSize = 7
                bindButton.TextColor3 = C.Text
            end)

            UIS.InputBegan:Connect(function(input, gameProcessed)
                if recording then
                    if input.KeyCode == Enum.KeyCode.Backspace then
                        currentKey = nil
                        bindButton.Text = "None"
                        bindButton.TextSize = 8
                        bindButton.TextColor3 = C.SubText
                        recording = false
                        return
                    end

                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        bindButton.Text = currentKey.Name
                        bindButton.TextSize = 8
                        bindButton.TextColor3 = C.Text
                        recording = false
                    end
                    return
                end

                if not gameProcessed and currentKey and input.KeyCode == currentKey then
                    enabled = not enabled
                    refreshToggle()
                end
            end)
        end

        return {
            Set = function(_, state)
                enabled = state == true
                refreshToggle()
            end,
            Get = function()
                return enabled
            end,
            GetKey = function()
                return currentKey
            end,
            SetColor = function(_, color)
                if typeof(color) ~= "Color3" then
                    return
                end
                currentColor = color
                colorSquare.BackgroundColor3 = color
                if colorEnabled then
                    local h, s, v = color:ToHSV()
                    hue, sat, val = h, s, v
                    applyColor()
                end
            end,
            GetColor = function()
                return currentColor
            end
        }
    end

    function page:AddButton(text, callback)
        local button = New("TextButton", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundColor3 = C.Element,
            BorderSizePixel = 0,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            ZIndex = 14
        })
        Corner(button, 4)
        button.MouseEnter:Connect(function()
            button.BackgroundColor3 = C.ElementHover
        end)
        button.MouseLeave:Connect(function()
            button.BackgroundColor3 = C.Element
        end)
        button.MouseButton1Click:Connect(function()
            if callback then
                callback()
            end
        end)
        return button
    end

    function page:AddSlider(text, min, max, default, callback)
        local value = math.clamp(default or min, min, max)
        local holder = New("Frame", {
            Parent = page.Frame,
            Size = UDim2.new(1, 0, 0, 25),
            BackgroundTransparency = 1,
            ZIndex = 14
        })

        New("TextLabel", {
            Parent = holder,
            Size = UDim2.new(0.35, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = C.Text,
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 15
        })

        local valueBox = New("TextBox", {
            Parent = holder,
            Position = UDim2.new(0.35, 4, 0.5, -9),
            Size = UDim2.fromOffset(30, 18),
            BackgroundColor3 = C.Element,
            Text = tostring(value),
            TextColor3 = C.SubText,
            TextSize = 8,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ClearTextOnFocus = false,
            ZIndex = 15
        })
        Corner(valueBox, 4)
        Stroke(valueBox)

        local bg = New("Frame", {
            Parent = holder,
            Position = UDim2.new(0.35, 40, 0.5, -3),
            Size = UDim2.new(0.65, -50, 0, 6),
            BackgroundColor3 = Color3.fromRGB(38, 38, 43),
            ZIndex = 14
        })
        Corner(bg, 6)

        local fill = New("Frame", {
            Parent = bg,
            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = C.Accent,
            ZIndex = 15
        })
        Corner(fill, 6)

        local draggingSlider = false

        local function setValue(v, fire)
            v = tonumber(v)
            if not v then
                valueBox.Text = tostring(value)
                return
            end
            value = math.clamp(v, min, max)
            if min % 1 == 0 and max % 1 == 0 then
                value = math.floor(value + 0.5)
            end
            valueBox.Text = tostring(value)
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            if fire and callback then
                callback(value)
            end
        end

        local function slide(input)
            local size = bg.AbsoluteSize.X
            if size <= 0 then
                return
            end
            local pos = Clamp01((input.Position.X - bg.AbsolutePosition.X) / size)
            setValue(min + pos * (max - min), true)
        end

        valueBox.FocusLost:Connect(function()
            setValue(valueBox.Text, true)
        end)

        bg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = true
                slide(input)
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                slide(input)
            end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = false
            end
        end)

        return {
            Set = function(_, v)
                setValue(v, false)
            end,
            Get = function()
                return value
            end
        }
    end

    return page
end

function NovaUI:Toggle()
    self.Gui.Enabled = not self.Gui.Enabled
    if not self.Gui.Enabled then
        ClosePicker(self)
    end
end

