--// NovaUI Compact
--// Roblox UI Library

local NovaUI = {}
NovaUI.__index = NovaUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer

----------------------------------------------------
-- COLORS
----------------------------------------------------

local C = {
    Background = Color3.fromRGB(13, 13, 15),
    Sidebar = Color3.fromRGB(16, 16, 19),
    Top = Color3.fromRGB(19, 19, 22),

    Element = Color3.fromRGB(21, 21, 25),
    ElementHover = Color3.fromRGB(27, 27, 32),

    Border = Color3.fromRGB(34, 34, 39),

    Text = Color3.fromRGB(225, 225, 230),
    SubText = Color3.fromRGB(135, 135, 142),

    Accent = Color3.fromRGB(235, 92, 96),
    Accent2 = Color3.fromRGB(180, 55, 60),
}

----------------------------------------------------
-- UTILITY
----------------------------------------------------

local function New(class, props)
    local obj = Instance.new(class)

    for i, v in pairs(props or {}) do
        obj[i] = v
    end

    return obj
end

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function Stroke(obj)
    local s = Instance.new("UIStroke")
    s.Color = C.Border
    s.Thickness = 1
    s.Transparency = 0
    s.Parent = obj
end

----------------------------------------------------
-- WINDOW
----------------------------------------------------

function NovaUI.new(title)

    local self = setmetatable({}, NovaUI)

    self.Pages = {}
    self.CurrentPage = nil

    self.Gui = New("ScreenGui", {
        Name = "NovaUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = Player:WaitForChild("PlayerGui")
    })

    ------------------------------------------------
    -- MAIN
    ------------------------------------------------

    self.Main = New("Frame", {
        Parent = self.Gui,

        Size = UDim2.fromOffset(410, 285),
        Position = UDim2.new(
            0.5, -205,
            0.5, -142
        ),

        BackgroundColor3 = C.Background,
        BorderSizePixel = 0
    })

    Corner(self.Main, 5)
    Stroke(self.Main)

    ------------------------------------------------
    -- TOP
    ------------------------------------------------

    self.Top = New("Frame", {
        Parent = self.Main,

        Size = UDim2.new(1, 0, 0, 32),

        BackgroundColor3 = C.Top,
        BorderSizePixel = 0
    })

    local titleLabel = New("TextLabel", {
        Parent = self.Top,

        Size = UDim2.new(1, -45, 1, 0),
        Position = UDim2.fromOffset(11, 0),

        BackgroundTransparency = 1,

        Text = title or "Nova",
        TextColor3 = C.Text,
        TextSize = 11,
        Font = Enum.Font.GothamBold,

        TextXAlignment = Enum.TextXAlignment.Left
    })

    ------------------------------------------------
    -- CLOSE
    ------------------------------------------------

    local close = New("TextButton", {
        Parent = self.Top,

        Size = UDim2.fromOffset(27, 25),
        Position = UDim2.new(1, -31, 0, 3),

        BackgroundTransparency = 1,

        Text = "×",
        TextColor3 = C.SubText,
        TextSize = 17,
        Font = Enum.Font.GothamMedium,

        AutoButtonColor = false
    })

    close.MouseEnter:Connect(function()
        close.TextColor3 = Color3.fromRGB(255, 80, 80)
    end)

    close.MouseLeave:Connect(function()
        close.TextColor3 = C.SubText
    end)

    close.MouseButton1Click:Connect(function()
        self.Gui.Enabled = false
    end)

    ------------------------------------------------
    -- SIDEBAR
    ------------------------------------------------

    self.Sidebar = New("Frame", {
        Parent = self.Main,

        Size = UDim2.new(0, 39, 1, -32),
        Position = UDim2.fromOffset(0, 32),

        BackgroundColor3 = C.Sidebar,
        BorderSizePixel = 0
    })

    local sideLayout = New("UIListLayout", {
        Parent = self.Sidebar,

        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,

        Padding = UDim.new(0, 5)
    })

    local sidePadding = Instance.new("UIPadding")
    sidePadding.PaddingTop = UDim.new(0, 8)
    sidePadding.Parent = self.Sidebar

    ------------------------------------------------
    -- CONTENT
    ------------------------------------------------

    self.Content = New("Frame", {
        Parent = self.Main,

        Size = UDim2.new(1, -39, 1, -32),
        Position = UDim2.fromOffset(39, 32),

        BackgroundColor3 = C.Background,
        BorderSizePixel = 0
    })

    ------------------------------------------------
    -- DRAG
    ------------------------------------------------

    local dragging = false
    local dragStart
    local startPos

    self.Top.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = true
            dragStart = input.Position
            startPos = self.Main.Position

            input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end

            end)

        end

    end)

    UIS.InputChanged:Connect(function(input)

        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

            local delta = input.Position - dragStart

            self.Main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,

                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )

        end

    end)

    return self
end

----------------------------------------------------
-- SELECT PAGE
----------------------------------------------------

function NovaUI:SelectPage(page)

    for _, p in ipairs(self.Pages) do

        p.Frame.Visible = false

        TweenService:Create(
            p.Button,
            TweenInfo.new(0.12),
            {
                BackgroundColor3 = C.Sidebar,
                TextColor3 = C.SubText
            }
        ):Play()

    end

    page.Frame.Visible = true

    TweenService:Create(
        page.Button,
        TweenInfo.new(0.12),
        {
            BackgroundColor3 = C.Accent2,
            TextColor3 = Color3.fromRGB(255,255,255)
        }
    ):Play()

    self.CurrentPage = page
end

