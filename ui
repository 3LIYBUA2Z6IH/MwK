--// NovaUI
--// Simple Roblox UI Library
--// Page-based interface with sidebar navigation

local NovaUI = {}
NovaUI.__index = NovaUI

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local function create(className, properties)
	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		object[property] = value
	end

	return object
end

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = parent
	return c
end

local function stroke(parent, color, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Transparency = transparency or 0
	s.Thickness = 1
	s.Parent = parent
	return s
end

local function padding(parent, left, right, top, bottom)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, left or 0)
	p.PaddingRight = UDim.new(0, right or 0)
	p.PaddingTop = UDim.new(0, top or 0)
	p.PaddingBottom = UDim.new(0, bottom or 0)
	p.Parent = parent
	return p
end

--------------------------------------------------
-- COLORS
--------------------------------------------------

local Colors = {
	Background = Color3.fromRGB(13, 14, 17),
	Sidebar = Color3.fromRGB(17, 18, 22),
	Panel = Color3.fromRGB(20, 21, 26),

	Text = Color3.fromRGB(235, 235, 240),
	SubText = Color3.fromRGB(135, 137, 145),

	Border = Color3.fromRGB(38, 40, 47),

	Element = Color3.fromRGB(25, 27, 32),
	ElementHover = Color3.fromRGB(31, 33, 40),

	Accent = Color3.fromRGB(123, 92, 255),
	AccentDark = Color3.fromRGB(91, 65, 210),
}

--------------------------------------------------
-- WINDOW
--------------------------------------------------

function NovaUI.new(title)
	local self = setmetatable({}, NovaUI)

	self.Pages = {}
	self.CurrentPage = nil

	------------------------------------------------
	-- SCREEN GUI
	------------------------------------------------

	self.ScreenGui = create("ScreenGui", {
		Name = "NovaUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	self.ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

	------------------------------------------------
	-- MAIN WINDOW
	------------------------------------------------

	self.Main = create("Frame", {
		Name = "Main",
		Parent = self.ScreenGui,

		Size = UDim2.fromOffset(650, 420),
		Position = UDim2.new(0.5, -325, 0.5, -210),

		BackgroundColor3 = Colors.Background,
		BorderSizePixel = 0,
	})

	corner(self.Main, 8)
	stroke(self.Main, Colors.Border, 0)

	------------------------------------------------
	-- TOP BAR
	------------------------------------------------

	self.TopBar = create("Frame", {
		Name = "TopBar",
		Parent = self.Main,

		Size = UDim2.new(1, 0, 0, 48),

		BackgroundColor3 = Colors.Panel,
		BorderSizePixel = 0,
	})

	corner(self.TopBar, 8)

	-- Cover bottom rounded corners
	create("Frame", {
		Parent = self.TopBar,
		Size = UDim2.new(1, 0, 0, 15),
		Position = UDim2.new(0, 0, 1, -15),
		BackgroundColor3 = Colors.Panel,
		BorderSizePixel = 0,
	})

	self.Title = create("TextLabel", {
		Parent = self.TopBar,

		Size = UDim2.new(1, -100, 1, 0),
		Position = UDim2.fromOffset(16, 0),

		BackgroundTransparency = 1,

		Text = title or "Nova UI",
		TextColor3 = Colors.Text,
		TextSize = 15,
		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,
	})

	------------------------------------------------
	-- CLOSE
	------------------------------------------------

	local close = create("TextButton", {
		Parent = self.TopBar,

		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(1, -42, 0, 7),

		BackgroundTransparency = 1,

		Text = "×",
		TextColor3 = Colors.SubText,
		TextSize = 22,
		Font = Enum.Font.GothamMedium,

		AutoButtonColor = false,
	})

	close.MouseEnter:Connect(function()
		close.TextColor3 = Color3.fromRGB(255, 90, 90)
	end)

	close.MouseLeave:Connect(function()
		close.TextColor3 = Colors.SubText
	end)

	close.MouseButton1Click:Connect(function()
		self.ScreenGui.Enabled = false
	end)

	------------------------------------------------
	-- SIDEBAR
	------------------------------------------------

	self.Sidebar = create("Frame", {
		Name = "Sidebar",
		Parent = self.Main,

		Size = UDim2.new(0, 68, 1, -48),
		Position = UDim2.fromOffset(0, 48),

		BackgroundColor3 = Colors.Sidebar,
		BorderSizePixel = 0,
	})

	padding(self.Sidebar, 9, 9, 12, 10)

	self.SidebarLayout = create("UIListLayout", {
		Parent = self.Sidebar,

		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,

		Padding = UDim.new(0, 8),
	})

	------------------------------------------------
	-- CONTENT
	------------------------------------------------

	self.Content = create("Frame", {
		Name = "Content",
		Parent = self.Main,

		Size = UDim2.new(1, -68, 1, -48),
		Position = UDim2.fromOffset(68, 48),

		BackgroundColor3 = Colors.Background,
		BorderSizePixel = 0,
	})

	padding(self.Content, 14, 14, 14, 14)

	------------------------------------------------
	-- DRAGGING
	------------------------------------------------

	local dragging = false
	local dragStart
	local startPosition

	self.TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPosition = self.Main.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart

			self.Main.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,

				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)

	return self
end

--------------------------------------------------
-- PAGE
--------------------------------------------------

function NovaUI:AddPage(name, icon)
	local page = {}

	page.Name = name
	page.Icon = icon or string.sub(name, 1, 1):upper()
	page.Controls = {}

	------------------------------------------------
	-- PAGE FRAME
	------------------------------------------------

	page.Frame = create("ScrollingFrame", {
		Name = name,
		Parent = self.Content,

		Size = UDim2.fromScale(1, 1),

		BackgroundTransparency = 1,
		BorderSizePixel = 0,

		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,

		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Colors.Border,

		Visible = false,
	})

	padding(page.Frame, 2, 4, 2, 8)

	page.Layout = create("UIListLayout", {
		Parent = page.Frame,

		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	})

	------------------------------------------------
	-- PAGE BUTTON
	------------------------------------------------

	local button = create("TextButton", {
		Parent = self.Sidebar,

		Size = UDim2.fromOffset(48, 42),

		BackgroundColor3 = Colors.Element,
		BorderSizePixel = 0,

		Text = page.Icon,
		TextColor3 = Colors.SubText,
		TextSize = 15,
		Font = Enum.Font.GothamBold,

		AutoButtonColor = false,
	})

	corner(button, 6)

	page.Button = button

	------------------------------------------------
	-- BUTTON HOVER
	------------------------------------------------

	button.MouseEnter:Connect(function()
		if self.CurrentPage ~= page then
			TweenService:Create(
				button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Colors.ElementHover
				}
			):Play()
		end
	end)

	button.MouseLeave:Connect(function()
		if self.CurrentPage ~= page then
			TweenService:Create(
				button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Colors.Element
				}
			):Play()
		end
	end)

	------------------------------------------------
	-- PAGE SWITCH
	------------------------------------------------

	button.MouseButton1Click:Connect(function()
		self:SelectPage(page)
	end)

	table.insert(self.Pages, page)

	if not self.CurrentPage then
		self:SelectPage(page)
	end

	------------------------------------------------
	-- PAGE METHODS
	------------------------------------------------

	function page:AddTitle(text)
		local title = create("TextLabel", {
			Parent = page.Frame,

			Size = UDim2.new(1, 0, 0, 25),

			BackgroundTransparency = 1,

			Text = text,
			TextColor3 = Colors.Text,
			TextSize = 17,
			Font = Enum.Font.GothamBold,

			TextXAlignment = Enum.TextXAlignment.Left,
		})

		return title
	end

	function page:AddLabel(text)
		local label = create("TextLabel", {
			Parent = page.Frame,

			Size = UDim2.new(1, 0, 0, 32),

			BackgroundTransparency = 1,

			Text = text,
			TextColor3 = Colors.SubText,
			TextSize = 12,
			Font = Enum.Font.GothamMedium,

			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
		})

		return label
	end

	------------------------------------------------
	-- TOGGLE
	------------------------------------------------

	function page:AddToggle(text, default, callback)

		local state = default or false

		local holder = create("TextButton", {
			Parent = page.Frame,

			Size = UDim2.new(1, 0, 0, 44),

			BackgroundColor3 = Colors.Element,
			BorderSizePixel = 0,

			Text = "",
			AutoButtonColor = false,
		})

		corner(holder, 6)

		local label = create("TextLabel", {
			Parent = holder,

			Size = UDim2.new(1, -65, 1, 0),
			Position = UDim2.fromOffset(13, 0),

			BackgroundTransparency = 1,

			Text = text,
			TextColor3 = Colors.Text,
			TextSize = 12,
			Font = Enum.Font.GothamMedium,

			TextXAlignment = Enum.TextXAlignment.Left,
		})

		local box = create("Frame", {
			Parent = holder,

			Size = UDim2.fromOffset(30, 18),
			Position = UDim2.new(1, -43, 0.5, -9),

			BackgroundColor3 = Color3.fromRGB(35, 37, 43),
			BorderSizePixel = 0,
		})

		corner(box, 9)

		local circle = create("Frame", {
			Parent = box,

			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(2, 2),

			BackgroundColor3 = Colors.SubText,
			BorderSizePixel = 0,
		})

		corner(circle, 20)

		local function update()
			if state then
				TweenService:Create(
					box,
					TweenInfo.new(0.15),
					{
						BackgroundColor3 = Colors.Accent
					}
				):Play()

				TweenService:Create(
					circle,
					TweenInfo.new(0.15),
					{
						Position = UDim2.fromOffset(14, 2),
						BackgroundColor3 = Color3.fromRGB(255,255,255)
					}
				):Play()
			else
				TweenService:Create(
					box,
					TweenInfo.new(0.15),
					{
						BackgroundColor3 = Color3.fromRGB(35,37,43)
					}
				):Play()

				TweenService:Create(
					circle,
					TweenInfo.new(0.15),
					{
						Position = UDim2.fromOffset(2, 2),
						BackgroundColor3 = Colors.SubText
					}
				):Play()
			end

			if callback then
				callback(state)
			end
		end

		holder.MouseButton1Click:Connect(function()
			state = not state
			update()
		end)

		update()

		return {
			Set = function(_, value)
				state = value
				update()
			end,

			Get = function()
				return state
			end,
		}
	end

	------------------------------------------------
	-- BUTTON
	------------------------------------------------

	function page:AddButton(text, callback)

		local button = create("TextButton", {
			Parent = page.Frame,

			Size = UDim2.new(1, 0, 0, 42),

			BackgroundColor3 = Colors.Element,
			BorderSizePixel = 0,

			Text = text,
			TextColor3 = Colors.Text,
			TextSize = 12,
			Font = Enum.Font.GothamMedium,

			AutoButtonColor = false,
		})

		corner(button, 6)

		button.MouseEnter:Connect(function()
			TweenService:Create(
				button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Colors.ElementHover
				}
			):Play()
		end)

		button.MouseLeave:Connect(function()
			TweenService:Create(
				button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Colors.Element
				}
			):Play()
		end)

		button.MouseButton1Click:Connect(function()
			if callback then
				callback()
			end
		end)

		return button
	end

	------------------------------------------------
	-- SLIDER
	------------------------------------------------

	function page:AddSlider(text, min, max, default, callback)

		local value = default or min

		local holder = create("Frame", {
			Parent = page.Frame,

			Size = UDim2.new(1, 0, 0, 58),

			BackgroundColor3 = Colors.Element,
			BorderSizePixel = 0,
		})

		corner(holder, 6)

		local label = create("TextLabel", {
			Parent = holder,

			Size = UDim2.new(1, -90, 0, 25),
			Position = UDim2.fromOffset(12, 5),

			BackgroundTransparency = 1,

			Text = text,
			TextColor3 = Colors.Text,
			TextSize = 12,
			Font = Enum.Font.GothamMedium,

			TextXAlignment = Enum.TextXAlignment.Left,
		})

		local valueLabel = create("TextLabel", {
			Parent = holder,

			Size = UDim2.fromOffset(65, 25),
			Position = UDim2.new(1, -75, 0, 5),

			BackgroundTransparency = 1,

			Text = tostring(value),
			TextColor3 = Colors.SubText,
			TextSize = 11,
			Font = Enum.Font.GothamMedium,

			TextXAlignment = Enum.TextXAlignment.Right,
		})

		local bar = create("Frame", {
			Parent = holder,

			Size = UDim2.new(1, -24, 0, 5),
			Position = UDim2.fromOffset(12, 40),

			BackgroundColor3 = Color3.fromRGB(35, 37, 43),
			BorderSizePixel = 0,
		})

		corner(bar, 5)

		local fill = create("Frame", {
			Parent = bar,

			Size = UDim2.new(
				(value - min) / (max - min),
				0,
				1,
				0
			),

			BackgroundColor3 = Colors.Accent,
			BorderSizePixel = 0,
		})

		corner(fill, 5)

		local draggingSlider = false

		local function setValue(input)
			local percent = math.clamp(
				(input.Position.X - bar.AbsolutePosition.X)
					/ bar.AbsoluteSize.X,
				0,
				1
			)

			value = math.floor(
				min + ((max - min) * percent)
			)

			valueLabel.Text = tostring(value)

			fill.Size = UDim2.new(percent, 0, 1, 0)

			if callback then
				callback(value)
			end
		end

		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
				setValue(input)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
				setValue(input)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		return {
			Set = function(_, newValue)
				value = math.clamp(newValue, min, max)

				local percent = (value - min) / (max - min)

				fill.Size = UDim2.new(percent, 0, 1, 0)
				valueLabel.Text = tostring(value)
			end,

			Get = function()
				return value
			end,
		}
	end

	return page
end

--------------------------------------------------
-- SELECT PAGE
--------------------------------------------------

function NovaUI:SelectPage(page)

	if self.CurrentPage == page then
		return
	end

	for _, otherPage in ipairs(self.Pages) do
		otherPage.Frame.Visible = false

		TweenService:Create(
			otherPage.Button,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Colors.Element,
				TextColor3 = Colors.SubText
			}
		):Play()
	end

	page.Frame.Visible = true

	TweenService:Create(
		page.Button,
		TweenInfo.new(0.15),
		{
			BackgroundColor3 = Colors.AccentDark,
			TextColor3 = Color3.fromRGB(255,255,255)
		}
	):Play()

	self.CurrentPage = page
end

--------------------------------------------------
-- TOGGLE UI
--------------------------------------------------

function NovaUI:Toggle()
	self.ScreenGui.Enabled = not self.ScreenGui.Enabled
end

return NovaUI
