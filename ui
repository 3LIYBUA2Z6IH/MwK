--// NovaUI Compact
--// Roblox UI Library

local NovaUI = {}
NovaUI.__index = NovaUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

for _, gui in ipairs(PlayerGui:GetChildren()) do
    if gui:IsA("ScreenGui") and gui.Name:sub(1, 6) == "NovaUI" then
        gui:Destroy()
    end
end

local C = {
    Background = Color3.fromRGB(13, 13, 15),
    Sidebar = Color3.fromRGB(16, 16, 19),
    Top = Color3.fromRGB(19, 19, 22),
    Element = Color3.fromRGB(21, 21, 25),
    ElementHover = Color3.fromRGB(27, 27, 32),
    Border = Color3.fromRGB(34, 34, 39),
    Text = Color3.fromRGB(225, 225, 230),
    SubText = Color3.fromRGB(135, 135, 142),
    Accent = Color3.fromRGB(235, 92, 96),
    Accent2 = Color3.fromRGB(180, 55, 60)
}

local function New(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function Stroke(obj)
    local s = Instance.new("UIStroke")
    s.Color = C.Border
    s.Thickness = 1
    s.Parent = obj
end

local function Clamp01(v)
    return math.clamp(v, 0, 1)
end

local function PlacePopup(button, popup)
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local p = button.AbsolutePosition
    local s = button.AbsoluteSize
    local width = popup.Size.X.Offset
    local height = popup.Size.Y.Offset

    local x = p.X + s.X - width
    local y = p.Y + s.Y + 5

    if x < 5 then x = 5 end
    if x + width > viewport.X - 5 then x = viewport.X - width - 5 end
    if y + height > viewport.Y - 5 then y = p.Y - height - 5 end
    if y < 5 then y = 5 end

    popup.Position = UDim2.fromOffset(x, y)
end

local function ClosePicker(self)
    if self.ActiveColorPicker then
        self.ActiveColorPicker.Visible = false
    end
    self.ActiveColorPicker = nil
    self.ActiveColorButton = nil
end

