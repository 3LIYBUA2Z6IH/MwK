    function Panel:AddSlider(name, min, max, default, cb)
        local val = default
        local f = New("Frame",{Parent=cont,BackgroundTransparency=1,Size=UDim2.new(1,0,0,25)})
        local lc = New("Frame",{Parent=f,BackgroundTransparency=1,Size=UDim2.new(0.35,0,1,0)})
        New("TextLabel",{Name="ItemName",Parent=lc,BackgroundTransparency=1,Size=UDim2.new(0.6,0,1,0),Font=Enum.Font.GothamMedium,Text=name,TextColor3=Theme.Text,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
        local vl = New("TextLabel",{Parent=lc,BackgroundTransparency=1,Position=UDim2.new(0.6,0,0,0),Size=UDim2.new(0.4,0,1,0),Font=Enum.Font.Gotham,Text=tostring(default),TextColor3=Theme.SubText,TextSize=12,TextXAlignment=Enum.TextXAlignment.Right})
        local bg = New("Frame",{Parent=f,BackgroundColor3=Theme.Input,Position=UDim2.new(0.35,10,0.5,-3),Size=UDim2.new(0.65,-10,0,6)},{New("UICorner",{CornerRadius=UDim.new(1,0)})})
        local ip = (default-min)/(max-min)
        local fill = New("Frame",{Parent=bg,BackgroundColor3=Theme.Accent,Size=UDim2.new(ip,0,1,0)},{New("UICorner",{CornerRadius=UDim.new(1,0)})})
        local hdl  = New("Frame",{Parent=fill,BackgroundColor3=Theme.Accent,Position=UDim2.new(1,0,0.5,0),Size=UDim2.fromOffset(10,10),AnchorPoint=Vector2.new(0.5,0.5)},{New("UICorner",{CornerRadius=UDim.new(1,0)}),New("UIStroke",{Color=Theme.Sidebar,Thickness=2})})
        local drag = false
        local bb = New("TextButton",{Parent=bg,BackgroundTransparency=1,Size=UDim2.new(1,0,3,0),Position=UDim2.new(0,0,-1,0),Text="",AutoButtonColor=false,ZIndex=5})
        local function upd(i)
            if not drag then return end
            local pos = math.clamp((i.Position.X-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1)
            local v = min+(pos*(max-min))
            local dec = (max-min<=10) or (min%1~=0) or (max%1~=0)
            if dec then v=math.floor(v*10+0.5)/10 vl.Text=string.format("%.1f",v)
            else v=math.round(v) vl.Text=tostring(v) end
            val=v
            TweenService:Create(fill,TweenInfo.new(0.05,Enum.EasingStyle.Linear),{Size=UDim2.new(pos,0,1,0)}):Play()
            if cb then cb(v) end
        end
        bb.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true TweenService:Create(hdl,TweenInfo.new(0.15),{Size=UDim2.fromOffset(12,12)}):Play() upd(i) end end)
        UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i) end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 and drag then drag=false TweenService:Create(hdl,TweenInfo.new(0.15),{Size=UDim2.fromOffset(10,10)}):Play() end end)
        return f
    end

    -- Combined toggle + optional keybind.
    -- `keybind = true` is handled by the caller through AddKey.
    function Panel:AddKey(name, opts)
        if typeof(opts)=="EnumItem" then opts={key=opts} end
        opts=opts or {}

        local ckey=opts.key or opts.Key or Enum.KeyCode.Unknown
        local cmode=opts.mode or opts.Mode or "Toggle"
        local cstate=opts.state
        if cstate == nil then cstate = opts.Default or false end
        local cb=opts.callback or opts.Callback or function()end
        local only=opts.onlyToggle or false

        local f=New("Frame",{Parent=cont,BackgroundTransparency=1,Size=UDim2.new(1,0,0,25)})
        local nl=New("TextLabel",{Name="ItemName",Parent=f,BackgroundTransparency=1,Size=UDim2.new(1,-130,1,0),Font=Enum.Font.GothamMedium,Text=name,TextColor3=cstate and Theme.Text or Theme.SubText,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
        local box=New("Frame",{Parent=f,BackgroundColor3=Theme.Input,Position=UDim2.new(1,0,0.5,0),Size=UDim2.fromOffset(18,18),AnchorPoint=Vector2.new(1,0.5)},{New("UICorner",{CornerRadius=UDim.new(0,4)})})
        local sq=New("Frame",{Parent=box,BackgroundColor3=Theme.Accent,Position=UDim2.new(0.5,0,0.5,0),Size=cstate and UDim2.fromOffset(12,12) or UDim2.fromOffset(0,0),AnchorPoint=Vector2.new(0.5,0.5)},{New("UICorner",{CornerRadius=UDim.new(0,2)})})
        local tb=New("TextButton",{Parent=box,BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Text=""})

        local kc,kuc,lc
        local active=false

        local function updateVisual()
            TweenService:Create(sq,TweenInfo.new(0.2),{Size=cstate and UDim2.fromOffset(12,12) or UDim2.fromOffset(0,0)}):Play()
            TweenService:Create(nl,TweenInfo.new(0.2),{TextColor3=cstate and Theme.Text or Theme.SubText}):Play()
        end

        local function setState(v, fire)
            cstate=v and true or false
            active=cstate
            updateVisual()
            if fire and cb then cb(cstate) end
        end

        local function disconnectKey()
            if kc then kc:Disconnect() kc=nil end
            if kuc then kuc:Disconnect() kuc=nil end
        end

        local function connectKey()
            disconnectKey()
            if ckey==Enum.KeyCode.Unknown then return end

            if cmode=="Toggle" then
                kc=UserInputService.InputBegan:Connect(function(i,gp)
                    if gp then return end
                    if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==ckey then
                        setState(not cstate,true)
                    end
                end)
            elseif cmode=="Hold" then
                kc=UserInputService.InputBegan:Connect(function(i,gp)
                    if not gp and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==ckey then
                        setState(true,true)
                    end
                end)
                kuc=UserInputService.InputEnded:Connect(function(i,gp)
                    if not gp and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==ckey then
                        setState(false,true)
                    end
                end)
            elseif cmode=="Always" then
                setState(true,true)
            end
        end

        tb.MouseButton1Click:Connect(function()
            if cmode=="Always" then return end
            setState(not cstate,true)
        end)

        local kb=New("TextButton",{Parent=f,BackgroundColor3=Theme.Input,Position=UDim2.new(1,-25,0.5,0),Size=UDim2.fromOffset(50,18),AnchorPoint=Vector2.new(1,0.5),Text=KN(ckey),Font=Enum.Font.Gotham,TextSize=11,TextColor3=Theme.SubText,AutoButtonColor=false},{New("UICorner",{CornerRadius=UDim.new(0,4)})})

        local mb
        if not only then
            mb=New("TextButton",{Parent=f,BackgroundTransparency=1,Position=UDim2.new(1,-80,0.5,0),Size=UDim2.fromOffset(40,18),AnchorPoint=Vector2.new(1,0.5),Text=cmode,Font=Enum.Font.Gotham,TextSize=11,TextColor3=Theme.SubText})
            mb.MouseButton1Click:Connect(function()
                if cmode=="Always" then return end
                setState(false,false)
                cmode=(cmode=="Toggle") and "Hold" or "Toggle"
                mb.Text=cmode
                connectKey()
            end)
        end

        local listening=false
        kb.MouseButton1Click:Connect(function()
            if listening then return end
            listening=true
            kb.Text="..."
            kb.TextColor3=Theme.Accent

            if lc then lc:Disconnect() lc=nil end
            lc=UserInputService.InputBegan:Connect(function(i,gp)
                if gp then return end
                if i.UserInputType==Enum.UserInputType.Keyboard then
                    ckey=(i.KeyCode==Enum.KeyCode.Escape or i.KeyCode==Enum.KeyCode.Backspace) and Enum.KeyCode.Unknown or i.KeyCode
                    kb.Text=KN(ckey)
                    kb.TextColor3=Theme.SubText
                    listening=false
                    if lc then lc:Disconnect() lc=nil end
                    connectKey()
                elseif i.UserInputType==Enum.UserInputType.MouseButton1 then
                    listening=false
                    kb.Text=KN(ckey)
                    kb.TextColor3=Theme.SubText
                    if lc then lc:Disconnect() lc=nil end
                end
            end)
        end)

        connectKey()

        local obj={Frame=f}
        function obj:Set(v)
            setState(v,true)
        end
        function obj:Get()
            return cstate
        end
        function obj:SetKeybind(k)
            ckey=k or Enum.KeyCode.Unknown
            kb.Text=KN(ckey)
            connectKey()
        end
        function obj:GetKeybind()
            return ckey
        end
        function obj:SetMode(mode)
            if mode~="Toggle" and mode~="Hold" and mode~="Always" then return end
            setState(false,false)
            cmode=mode
            if mb then mb.Text=cmode end
            connectKey()
        end
        function obj:GetMode()
            return cmode
        end

        return obj
    end

    -- Standalone editable keybind.
    function Panel:AddKeybind(name, defaultKey, cb)
        local key=defaultKey or Enum.KeyCode.Unknown
        local row=New("Frame",{Parent=cont,BackgroundTransparency=1,Size=UDim2.new(1,0,0,25)})
        New("TextLabel",{Parent=row,BackgroundTransparency=1,Size=UDim2.new(1,-65,1,0),Font=Enum.Font.GothamMedium,Text=name,TextColor3=Theme.Text,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
        local button=New("TextButton",{Parent=row,BackgroundColor3=Theme.Input,Position=UDim2.new(1,0,0.5,0),Size=UDim2.fromOffset(50,18),AnchorPoint=Vector2.new(1,0.5),Text=KN(key),Font=Enum.Font.Gotham,TextSize=11,TextColor3=Theme.SubText,AutoButtonColor=false},{New("UICorner",{CornerRadius=UDim.new(0,4)})})

        local listening=false
        local conn
        local obj={Frame=row}

        local function setKey(k,fire)
            key=k or Enum.KeyCode.Unknown
            button.Text=KN(key)
            if fire and cb then cb(key) end
        end

        function obj:Set(k)
            setKey(k,true)
        end
        function obj:Get()
            return key
        end

        button.MouseButton1Click:Connect(function()
            if listening then return end
            listening=true
            button.Text="..."
            button.TextColor3=Theme.Accent

            if conn then conn:Disconnect() end
            conn=UserInputService.InputBegan:Connect(function(i,gp)
                if gp then return end
                if i.UserInputType==Enum.UserInputType.Keyboard then
                    setKey((i.KeyCode==Enum.KeyCode.Escape or i.KeyCode==Enum.KeyCode.Backspace) and Enum.KeyCode.Unknown or i.KeyCode,true)
                    button.TextColor3=Theme.SubText
                    listening=false
                    conn:Disconnect()
                    conn=nil
                elseif i.UserInputType==Enum.UserInputType.MouseButton1 then
                    button.Text=KN(key)
                    button.TextColor3=Theme.SubText
                    listening=false
                    conn:Disconnect()
                    conn=nil
                end
            end)
        end)

        return obj
    end

