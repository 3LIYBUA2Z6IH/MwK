local function New(cls, props, children)
    local i = Instance.new(cls)
    for k,v in pairs(props or {}) do i[k]=v end
    if children then for _,c in pairs(children) do c.Parent=i end end
    return i
end

local function Draggable(drag, move)
    local dragging, di, ds, sp
    drag.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true ds=i.Position sp=move.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then dragging=false end end)
        end
    end)
    drag.InputChanged:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseMovement then di=i end end)
    UserInputService.InputChanged:Connect(function(i)
        if i==di and dragging then
            local d=i.Position-ds
            move.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
end

local function FromHex(h)
    h=h:gsub("#","")
    if #h==6 then
        local r,g,b=tonumber(h:sub(1,2),16),tonumber(h:sub(3,4),16),tonumber(h:sub(5,6),16)
        if r and g and b then return Color3.fromRGB(r,g,b) end
    end
end

